{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.11.2/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true,
      "draft": true,
      "force-tag-creation": true,
      "pull-request-title-pattern": "chore(repo): release ${version}",
      "extra-files": [
        {
          "type": "json",
          "path": "apps/desktop/src-tauri/tauri.conf.json",
          "jsonpath": "$.version"
        },
        {
          "type": "toml",
          "path": "apps/desktop/src-tauri/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "apps/desktop/src-tauri/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value == 'tendb-desktop')].version"
        }
      ]
    }
  }
}
