{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$CLAUDE_ENV_FILE\" ] && command -v mise >/dev/null 2>&1; then mise activate bash --shims >> \"$CLAUDE_ENV_FILE\"; fi"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.mjs\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git fetch -q origin)",
      "Bash(git fetch origin)",
      "Bash(make check-changed)",
      "Bash(make precheck)",
      "Bash(pnpm exec prettier --check *)",
      "Bash(pnpm exec vitest run *)",
      "Bash(pnpm exec vitest related *)",
      "Bash(pnpm exec tsc --noEmit)",
      "Bash(node ~/.10db/skills/10db-task/tendb.mjs context)",
      "Bash(node ~/.10db/skills/10db-task/tendb.mjs inbox)",
      "Bash(node ~/.10db/skills/10db-task/tendb.mjs project *)",
      "Bash(node ~/.10db/skills/10db-task/tendb.mjs areas *)",
      "Bash(node ~/.10db/skills/10db-task/tendb.mjs knowledge *)"
    ]
  }
}
