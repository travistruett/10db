{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "cares_most": {
      "type": "string",
      "minLength": 1
    },
    "budget": {
      "type": "object",
      "properties": {
        "tokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "dollars": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "criteria": {
      "default": [],
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "check": {
                "type": "string",
                "const": "task"
              },
              "task": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              }
            },
            "required": [
              "text",
              "check",
              "task"
            ]
          },
          {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "check": {
                "type": "string",
                "const": "merged"
              },
              "task": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              }
            },
            "required": [
              "text",
              "check",
              "task"
            ]
          },
          {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "check": {
                "type": "string",
                "const": "command"
              },
              "command": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "text",
              "check"
            ]
          },
          {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "check": {
                "type": "string",
                "const": "accept"
              },
              "person": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "text",
              "check"
            ]
          }
        ]
      }
    },
    "tasks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "default": "",
            "type": "string"
          },
          "criteria": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "areas": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "depends_on": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          }
        },
        "required": [
          "key",
          "title",
          "areas"
        ]
      }
    },
    "people": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "default": "stakeholder",
            "type": "string",
            "enum": [
              "owner",
              "stakeholder"
            ]
          },
          "channel": {
            "type": "string",
            "enum": [
              "in_app",
              "slack"
            ]
          },
          "receives": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "digest",
                "questions",
                "screenshots"
              ]
            }
          }
        },
        "required": [
          "name"
        ]
      }
    }
  },
  "required": [
    "title",
    "objective",
    "tasks"
  ]
}
