{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "areas": {
      "type": "object",
      "properties": {
        "proposed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "globs": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "catchAll": {
                "type": "boolean"
              },
              "role": {
                "type": "string",
                "enum": [
                  "page",
                  "shared"
                ]
              },
              "route": {
                "type": "string",
                "maxLength": 500,
                "format": "starts_with",
                "pattern": "^\\/.*"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "required": [
              "name",
              "globs"
            ]
          }
        },
        "kept": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "reason"
            ]
          }
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "route": {
                "type": "string",
                "maxLength": 500,
                "format": "starts_with",
                "pattern": "^\\/.*"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "folders": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "was": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "globs": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "catchAll": {
                    "type": "boolean"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "page",
                      "shared"
                    ]
                  },
                  "route": {
                    "type": "string",
                    "maxLength": 500,
                    "format": "starts_with",
                    "pattern": "^\\/.*"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  }
                },
                "required": [
                  "name",
                  "globs"
                ]
              }
            },
            "required": [
              "name",
              "folders"
            ]
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "reason"
            ]
          }
        },
        "splits": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "into": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "globs": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "catchAll": {
                      "type": "boolean"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "page",
                        "shared"
                      ]
                    },
                    "route": {
                      "type": "string",
                      "maxLength": 500,
                      "format": "starts_with",
                      "pattern": "^\\/.*"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    }
                  },
                  "required": [
                    "name",
                    "globs"
                  ]
                }
              },
              "was": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "globs": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "catchAll": {
                    "type": "boolean"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "page",
                      "shared"
                    ]
                  },
                  "route": {
                    "type": "string",
                    "maxLength": 500,
                    "format": "starts_with",
                    "pattern": "^\\/.*"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  }
                },
                "required": [
                  "name",
                  "globs"
                ]
              },
              "tasks": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "from",
              "into",
              "was",
              "tasks"
            ]
          }
        }
      },
      "required": [
        "proposed",
        "kept",
        "pages",
        "skipped"
      ]
    },
    "settings": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "const": "appUrl"
              },
              "value": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "field",
              "value",
              "source"
            ]
          },
          {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "const": "devLoginCommand"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "field",
              "value",
              "source"
            ]
          },
          {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "const": "changedCheckCommand"
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "field",
              "value",
              "source"
            ]
          },
          {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "const": "sandboxDocker"
              },
              "value": {
                "type": "boolean",
                "const": true
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "field",
              "value",
              "source"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "areas",
    "settings"
  ]
}
