{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "projectId": {
      "description": "Needed only to move a \"you\" record into a project.",
      "type": "string",
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "scope": {
      "type": "string",
      "enum": [
        "you",
        "project",
        "area"
      ]
    },
    "area": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "choice": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "rationale": {
      "type": "string"
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "kind": {
      "type": "string",
      "enum": [
        "policy",
        "heuristic",
        "belief"
      ]
    },
    "topicKey": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "quote": {
      "description": "The builder's own words that led to this, quoted as they said them. Omit if there are none.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "id"
  ],
  "additionalProperties": false
}
