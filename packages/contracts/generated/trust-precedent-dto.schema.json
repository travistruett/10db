{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^tpd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "programKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[^\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}]+$"
    },
    "scope": {
      "type": "string",
      "enum": [
        "copy",
        "project"
      ]
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}]+$"
    },
    "examples": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[^\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}]+$"
      }
    },
    "runsHash": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "declined",
        "revoked"
      ]
    },
    "uses": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "lastUsedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "conflicts": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "sourceInboxId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^inb_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "approvedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string"
    },
    "endedAt": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "projectId",
    "programKey",
    "scope",
    "kind",
    "examples",
    "runsHash",
    "state",
    "uses",
    "lastUsedAt",
    "conflicts",
    "sourceInboxId",
    "approvedAt",
    "createdAt",
    "endedAt"
  ]
}
