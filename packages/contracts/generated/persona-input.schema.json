{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "role": {
      "type": "string",
      "enum": [
        "plan",
        "plan_review",
        "implement",
        "review",
        "qa"
      ]
    },
    "tools": {
      "type": "string",
      "enum": [
        "read_only",
        "edit"
      ]
    },
    "instructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "skills": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,39}$"
      }
    },
    "minimumScore": {
      "default": null,
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "modelPin": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "effort": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            }
          },
          "required": [
            "model",
            "effort"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "key",
    "name",
    "role",
    "tools",
    "instructions"
  ]
}
