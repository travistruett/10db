{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "task"
        },
        "taskId": {
          "type": "string",
          "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "title": {
          "type": "string"
        },
        "column": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "taskId",
        "title",
        "column"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "task_edit"
        },
        "taskId": {
          "type": "string",
          "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "title": {
          "type": "string"
        },
        "previous": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "why": {
              "type": "string",
              "maxLength": 200
            },
            "description": {
              "type": "string"
            },
            "acceptanceCriteria": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "rigor": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "light",
                    "standard",
                    "careful",
                    "critical"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "kinds": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,39}$"
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "builder",
                      "agent",
                      "rules",
                      "judge"
                    ]
                  }
                },
                "required": [
                  "key",
                  "source"
                ]
              }
            },
            "kindsOff": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,39}$"
              }
            },
            "effortPin": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "areas": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              }
            },
            "landing": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "base"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "branch"
                    },
                    "branch": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
                    }
                  },
                  "required": [
                    "kind",
                    "branch"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "hold"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              ]
            }
          }
        }
      },
      "required": [
        "kind",
        "taskId",
        "title",
        "previous"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "title"
        },
        "title": {
          "type": "string"
        },
        "previousTitle": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "title",
        "previousTitle"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "start"
        },
        "taskId": {
          "type": "string",
          "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "started": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "kind",
        "taskId",
        "started"
      ]
    }
  ]
}
