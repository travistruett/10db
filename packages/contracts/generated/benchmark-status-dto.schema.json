{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "keyConfigured": {
      "type": "boolean"
    },
    "lastSyncAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "lastSuccessAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "ok",
            "no_key",
            "unauthorized",
            "rate_limited",
            "failed"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "type": [
        "string",
        "null"
      ]
    },
    "models": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "indexVersion": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "unmeasuredProfiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missingScores": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string"
          },
          "kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "intelligence",
                "coding",
                "agentic"
              ]
            }
          }
        },
        "required": [
          "profile",
          "kinds"
        ]
      }
    }
  },
  "required": [
    "keyConfigured",
    "lastSyncAt",
    "lastSuccessAt",
    "outcome",
    "message",
    "models",
    "unmeasuredProfiles"
  ]
}
