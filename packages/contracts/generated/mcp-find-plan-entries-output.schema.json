{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "hits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "intent",
              "fact",
              "experiment",
              "name",
              "decision",
              "question",
              "section"
            ]
          },
          "key": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "snippet": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "key",
          "title",
          "snippet"
        ]
      }
    },
    "empty": {
      "type": "boolean"
    }
  },
  "required": [
    "hits",
    "empty"
  ]
}
