{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "period": {
      "type": "number",
      "enum": [
        7,
        14,
        30
      ]
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rigor": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "light",
                  "standard",
                  "careful",
                  "critical"
                ]
              },
              {
                "type": "string",
                "const": "all"
              }
            ]
          },
          "tasksDone": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "stepsPerTask": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "sessionsPerTask": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "pullRequestsPerTask": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "stepsPerGoal": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "sessionsPerGoal": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "pullRequestsPerGoal": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "sentBackPerTask": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "shippedWithFindings": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "rigor",
          "tasksDone",
          "stepsPerTask",
          "sessionsPerTask",
          "pullRequestsPerTask",
          "stepsPerGoal",
          "sessionsPerGoal",
          "pullRequestsPerGoal",
          "sentBackPerTask",
          "shippedWithFindings"
        ]
      }
    },
    "judgeOverride": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "calls": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "overridden": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "calls",
            "overridden"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "period",
    "rows",
    "judgeOverride"
  ]
}
