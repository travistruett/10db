{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "day": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "usd": {
      "type": "number"
    },
    "share": {
      "type": "number"
    },
    "unmeasured": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "carryOns": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "measure": {
      "type": "string",
      "enum": [
        "usd",
        "share",
        "sessions"
      ]
    },
    "reached": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "usd",
            "share",
            "sessions"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "day",
    "usd",
    "share",
    "unmeasured",
    "carryOns",
    "measure",
    "reached"
  ]
}
