{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "base": {
      "type": "string"
    },
    "gate": {
      "type": "string",
      "enum": [
        "scratch",
        "folder_at_close",
        "none"
      ]
    },
    "review": {
      "type": "string",
      "enum": [
        "started",
        "unchanged",
        "none"
      ]
    }
  },
  "required": [
    "url",
    "base",
    "gate",
    "review"
  ]
}
