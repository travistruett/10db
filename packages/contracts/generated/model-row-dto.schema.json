{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "maker": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "family": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "tier": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "efficient",
            "balanced",
            "capable",
            "frontier"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "current",
        "superseded",
        "retired",
        "unknown",
        "not_runnable"
      ]
    },
    "availableOn": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^acc_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inputPrice": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "outputPrice": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "intelligence": {
      "type": [
        "number",
        "null"
      ]
    },
    "costPerTaskUsd": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "outputTokensPerSecond": {
      "type": [
        "number",
        "null"
      ]
    },
    "coding": {
      "default": null,
      "type": [
        "number",
        "null"
      ]
    },
    "agentic": {
      "default": null,
      "type": [
        "number",
        "null"
      ]
    },
    "sources": {
      "default": {
        "intelligence": null,
        "coding": null,
        "agentic": null,
        "costPerTask": null,
        "speed": null
      },
      "type": "object",
      "properties": {
        "intelligence": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "aa",
                "aa_via_openrouter",
                "openrouter"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "coding": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "aa",
                "aa_via_openrouter",
                "openrouter"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "agentic": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "aa",
                "aa_via_openrouter",
                "openrouter"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "costPerTask": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "aa",
                "aa_via_openrouter",
                "openrouter"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "speed": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "aa",
                "aa_via_openrouter",
                "openrouter"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "intelligence",
        "coding",
        "agentic",
        "costPerTask",
        "speed"
      ]
    },
    "speedProvider": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "efforts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "profileId": {
            "type": "string",
            "pattern": "^mpf_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "effort": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ]
          },
          "intelligence": {
            "type": [
              "number",
              "null"
            ]
          },
          "costPerTaskUsd": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "outputTokensPerSecond": {
            "type": [
              "number",
              "null"
            ]
          },
          "coding": {
            "default": null,
            "type": [
              "number",
              "null"
            ]
          },
          "agentic": {
            "default": null,
            "type": [
              "number",
              "null"
            ]
          },
          "sources": {
            "default": {
              "intelligence": null,
              "coding": null,
              "agentic": null,
              "costPerTask": null,
              "speed": null
            },
            "type": "object",
            "properties": {
              "intelligence": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "aa",
                      "aa_via_openrouter",
                      "openrouter"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "coding": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "aa",
                      "aa_via_openrouter",
                      "openrouter"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "agentic": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "aa",
                      "aa_via_openrouter",
                      "openrouter"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "costPerTask": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "aa",
                      "aa_via_openrouter",
                      "openrouter"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "speed": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "aa",
                      "aa_via_openrouter",
                      "openrouter"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "intelligence",
              "coding",
              "agentic",
              "costPerTask",
              "speed"
            ]
          },
          "speedProvider": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "stepsRun": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "firstPassSteps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "profileId",
          "effort",
          "intelligence",
          "costPerTaskUsd",
          "outputTokensPerSecond",
          "stepsRun",
          "firstPassSteps"
        ]
      }
    },
    "stepsRun": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "firstSeenAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "model",
    "name",
    "maker",
    "family",
    "tier",
    "status",
    "availableOn",
    "providers",
    "inputPrice",
    "outputPrice",
    "intelligence",
    "costPerTaskUsd",
    "outputTokensPerSecond",
    "efforts",
    "stepsRun",
    "firstSeenAt"
  ]
}
