{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "suites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "suiteKey": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "not_run",
              "passing",
              "failing",
              "regressed",
              "eval_changed"
            ]
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "liveCommand": {
            "type": [
              "string",
              "null"
            ]
          },
          "before": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  },
                  "passed": {
                    "type": "boolean"
                  },
                  "fingerprint": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "models": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "model": {
                          "type": "string"
                        },
                        "passed": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "model",
                        "passed"
                      ]
                    }
                  }
                },
                "required": [
                  "path",
                  "at",
                  "passed",
                  "fingerprint",
                  "models"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "after": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  },
                  "passed": {
                    "type": "boolean"
                  },
                  "fingerprint": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "models": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "model": {
                          "type": "string"
                        },
                        "passed": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "model",
                        "passed"
                      ]
                    }
                  }
                },
                "required": [
                  "path",
                  "at",
                  "passed",
                  "fingerprint",
                  "models"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "suiteKey",
          "label",
          "state",
          "paths",
          "liveCommand",
          "before",
          "after"
        ]
      }
    }
  },
  "required": [
    "suites"
  ]
}
