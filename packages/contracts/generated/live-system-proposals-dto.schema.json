{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entry": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\p{Cc}\\p{Cf}\\u2028\\u2029]+$"
          },
          "source": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "path",
              "line"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "entry",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "proposals"
  ],
  "additionalProperties": false
}
