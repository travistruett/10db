{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "opId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,100}$",
      "description": "A unique ID for this call. Reuse it only when retrying the same call."
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "exitCode": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "opId",
    "command",
    "exitCode",
    "summary"
  ]
}
