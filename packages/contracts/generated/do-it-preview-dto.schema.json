{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "brief": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "areas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "agent",
                "chat"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "mid_turn",
                "paused",
                "timeout"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "writing": {
          "type": "boolean"
        }
      },
      "required": [
        "title",
        "text",
        "areas",
        "criteria",
        "source",
        "reason",
        "writing"
      ]
    },
    "changed": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "M",
              "A",
              "D",
              "R",
              "?"
            ]
          }
        },
        "required": [
          "path",
          "status"
        ]
      }
    },
    "more": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "worktree": {
      "type": "object",
      "properties": {
        "offered": {
          "type": "boolean"
        },
        "refusal": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "link": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "code",
                "message",
                "link"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "whenBusy": {
          "type": "boolean"
        }
      },
      "required": [
        "offered",
        "refusal",
        "whenBusy"
      ]
    },
    "here": {
      "type": "object",
      "properties": {
        "offered": {
          "type": "boolean"
        },
        "refusal": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "link": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "code",
                "message",
                "link"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "whenBusy": {
          "type": "boolean"
        }
      },
      "required": [
        "offered",
        "refusal",
        "whenBusy"
      ]
    },
    "runningTurn": {
      "type": "boolean"
    },
    "stacksOn": {
      "type": [
        "string",
        "null"
      ]
    },
    "base": {
      "type": [
        "string",
        "null"
      ]
    },
    "leftOut": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "branch": {
              "type": "string"
            },
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "branch",
            "count"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "brief",
    "changed",
    "more",
    "worktree",
    "here",
    "runningTurn",
    "stacksOn",
    "base",
    "leftOut"
  ]
}
