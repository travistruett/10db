{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string"
    },
    "acceptanceCriteria": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "riskTags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "security",
          "auth",
          "migration",
          "dependency"
        ]
      }
    },
    "flowId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^flw_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
