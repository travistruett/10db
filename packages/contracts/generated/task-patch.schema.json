{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "headline": {
      "type": "string",
      "maxLength": 80
    },
    "why": {
      "type": "string",
      "maxLength": 200
    },
    "description": {
      "type": "string"
    },
    "acceptanceCriteria": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rigor": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "light",
            "standard",
            "careful",
            "critical"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "kinds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "source": {
            "type": "string",
            "enum": [
              "builder",
              "agent",
              "rules",
              "judge"
            ]
          }
        },
        "required": [
          "key",
          "source"
        ]
      }
    },
    "kindsOff": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,39}$"
      }
    },
    "effortPin": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "areas": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "landing": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "base"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "branch"
            },
            "branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
            }
          },
          "required": [
            "kind",
            "branch"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "hold"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "workspaceMode": {
      "type": "string",
      "enum": [
        "shared",
        "worktree"
      ]
    },
    "modelSetting": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "automatic"
                },
                "minimum": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "kind"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "tier"
                },
                "tier": {
                  "type": "string",
                  "enum": [
                    "efficient",
                    "balanced",
                    "capable",
                    "frontier"
                  ]
                }
              },
              "required": [
                "kind",
                "tier"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "top_of_tier"
                },
                "tier": {
                  "type": "string",
                  "enum": [
                    "efficient",
                    "balanced",
                    "capable",
                    "frontier"
                  ]
                }
              },
              "required": [
                "kind"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "model"
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "model"
              ]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
