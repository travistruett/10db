{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "passId": {
      "type": "string",
      "pattern": "^pas_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tookOut": {
      "type": "boolean"
    },
    "keptSha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "stillChanging": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "left": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "taskId",
    "passId",
    "tookOut",
    "keptSha",
    "stillChanging",
    "left"
  ]
}
