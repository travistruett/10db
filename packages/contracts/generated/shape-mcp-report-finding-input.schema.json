{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "effortKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "taskKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "taskHash": {
      "type": "string",
      "minLength": 1
    },
    "final": {
      "type": "boolean"
    },
    "reviewer": {
      "type": "string",
      "enum": [
        "scope",
        "engineering",
        "rehearsal"
      ]
    },
    "finding": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "finding"
            },
            "severity": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "severity",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "question"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    }
  },
  "required": [
    "effortKey",
    "finding"
  ]
}
