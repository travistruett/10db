{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "configHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "approved",
        "denied"
      ]
    }
  },
  "required": [
    "configHash",
    "verdict"
  ]
}
