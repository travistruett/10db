{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workstreamId": {
      "type": "string",
      "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "kind": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "tool": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "name",
            "target"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "turn": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^ptn_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "filesTouched": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "id",
            "filesTouched"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "workstreamId",
    "kind",
    "summary",
    "tool",
    "turn"
  ]
}
