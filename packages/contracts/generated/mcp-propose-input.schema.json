{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "opId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,100}$",
      "description": "A unique ID for this call. Reuse it only when retrying the same call."
    },
    "kind": {
      "type": "string",
      "enum": [
        "new_task",
        "change_task",
        "principle",
        "note",
        "watchpoint"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "string",
      "minLength": 1
    },
    "kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,39}$"
      }
    },
    "riskTags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "security",
          "auth",
          "migration",
          "dependency"
        ]
      }
    },
    "joinsRunningBatch": {
      "type": "boolean"
    },
    "principle": {
      "description": "For kind \"principle\": the rule itself. Without it, the body is used as the statement.",
      "type": "object",
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "One rule, phrased as an instruction."
        },
        "kind": {
          "default": "heuristic",
          "description": "policy = must, heuristic = prefer, belief = context.",
          "type": "string",
          "enum": [
            "policy",
            "heuristic",
            "belief"
          ]
        },
        "topicKey": {
          "description": "A short stable key such as testing.no-sleeps; a later principle with the same key and scope replaces this one.",
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "scope": {
          "default": "project",
          "type": "string",
          "enum": [
            "you",
            "project",
            "area"
          ]
        },
        "area": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "quote": {
          "description": "The words this principle comes from, quoted exactly.",
          "type": "string",
          "maxLength": 2000
        },
        "rationale": {
          "description": "Why the rule holds, in a sentence.",
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "statement"
      ]
    },
    "watchpoint": {
      "description": "For kind \"watchpoint\": the watchpoint to add, or to replace by its key, in this project (scope \"project\", where an entry may also be { key, off: true }) or for every project (scope \"you\"). The body says why.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "project"
            },
            "entry": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "why": {
                      "type": "string",
                      "maxLength": 400
                    },
                    "globs": {
                      "minItems": 1,
                      "maxItems": 64,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "lines": {
                      "default": [],
                      "maxItems": 16,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "question": {
                      "default": null,
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 400
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "guidance": {
                      "type": "string",
                      "maxLength": 2000
                    },
                    "knowledge": {
                      "default": [],
                      "maxItems": 8,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 80,
                        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
                      }
                    },
                    "loudness": {
                      "type": "string",
                      "enum": [
                        "show",
                        "ask",
                        "hold"
                      ]
                    },
                    "starter": {
                      "default": null,
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "key",
                    "label",
                    "why",
                    "globs",
                    "guidance",
                    "loudness"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "off": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": [
                    "key",
                    "off"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "scope",
            "entry"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "you"
            },
            "entry": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "why": {
                  "type": "string",
                  "maxLength": 400
                },
                "globs": {
                  "minItems": 1,
                  "maxItems": 64,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "lines": {
                  "default": [],
                  "maxItems": 16,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "question": {
                  "default": null,
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 400
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "guidance": {
                  "type": "string",
                  "maxLength": 2000
                },
                "knowledge": {
                  "default": [],
                  "maxItems": 8,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 80,
                    "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
                  }
                },
                "loudness": {
                  "type": "string",
                  "enum": [
                    "show",
                    "ask",
                    "hold"
                  ]
                },
                "starter": {
                  "default": null,
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "key",
                "label",
                "why",
                "globs",
                "guidance",
                "loudness"
              ]
            }
          },
          "required": [
            "scope",
            "entry"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "opId",
    "kind",
    "title",
    "body"
  ]
}
