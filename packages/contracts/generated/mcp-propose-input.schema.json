{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "opId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,100}$",
      "description": "A unique ID for this call. Reuse it only when retrying the same call."
    },
    "kind": {
      "type": "string",
      "enum": [
        "new_task",
        "change_task",
        "principle",
        "note"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "string",
      "minLength": 1
    },
    "principle": {
      "description": "For kind \"principle\": the rule itself. Without it, the body is used as the statement.",
      "type": "object",
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "One rule, phrased as an instruction."
        },
        "kind": {
          "default": "heuristic",
          "description": "policy = must, heuristic = prefer, belief = context.",
          "type": "string",
          "enum": [
            "policy",
            "heuristic",
            "belief"
          ]
        },
        "topicKey": {
          "description": "A short stable key such as testing.no-sleeps; a later principle with the same key and scope replaces this one.",
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "scope": {
          "default": "project",
          "type": "string",
          "enum": [
            "you",
            "project",
            "area"
          ]
        },
        "area": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "quote": {
          "description": "The words this principle comes from, quoted exactly.",
          "type": "string",
          "maxLength": 2000
        },
        "rationale": {
          "description": "Why the rule holds, in a sentence.",
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "statement"
      ]
    }
  },
  "required": [
    "opId",
    "kind",
    "title",
    "body"
  ]
}
