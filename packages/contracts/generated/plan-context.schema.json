{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "shapeId": {
      "type": "string",
      "pattern": "^shp_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revisionId": {
      "type": "string",
      "pattern": "^sar_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string"
    },
    "document": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "key",
        "title",
        "revision"
      ]
    },
    "goal": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "objective": {
              "type": "string"
            },
            "why": {
              "type": "string"
            }
          },
          "required": [
            "objective",
            "why"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "section": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "ref",
        "text"
      ]
    },
    "shared": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "ref",
          "text"
        ]
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "choice": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "lasting": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "choice",
          "rationale",
          "lasting"
        ]
      }
    },
    "names": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "version",
          "name",
          "definition"
        ]
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "experiment"
            ]
          },
          "line": {
            "type": "string"
          },
          "anchors": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "code"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "commit": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{7,40}$"
                    },
                    "excerpt": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "path",
                    "line",
                    "commit",
                    "excerpt"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "url"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "readAt": {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                    }
                  },
                  "required": [
                    "kind",
                    "url",
                    "readAt"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "entryKey": {
                  "type": "string"
                },
                "anchorIndex": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "result": {
                  "type": "string",
                  "enum": [
                    "current",
                    "moved",
                    "changed",
                    "unchecked",
                    "url"
                  ]
                },
                "line": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "checkedCommit": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "workstreamId": {
                  "type": "string",
                  "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                }
              },
              "required": [
                "entryKey",
                "anchorIndex",
                "result",
                "line",
                "checkedCommit",
                "note",
                "workstreamId",
                "at"
              ]
            }
          }
        },
        "required": [
          "key",
          "version",
          "kind",
          "line",
          "anchors",
          "checks"
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "severity",
          "text"
        ]
      }
    },
    "intent": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "quote": {
            "type": "string"
          },
          "speaker": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "version",
          "quote",
          "speaker"
        ]
      }
    },
    "notIncluded": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "used": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "shapeId",
    "revisionId",
    "title",
    "document",
    "goal",
    "section",
    "shared",
    "decisions",
    "names",
    "facts",
    "findings",
    "intent",
    "notIncluded",
    "budget",
    "used"
  ]
}
