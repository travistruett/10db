{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "minLength": 1
    },
    "unfinished": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "title": {
            "type": "string"
          },
          "working": {
            "type": "boolean"
          },
          "sharedUnlanded": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "seq": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "paths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "dropRefusal": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "laterPages": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "seq",
                "paths",
                "dropRefusal",
                "laterPages"
              ]
            }
          }
        },
        "required": [
          "taskId",
          "title",
          "working",
          "sharedUnlanded"
        ]
      }
    },
    "unowned": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "added": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "removed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "fromBeforePass": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "added",
          "removed",
          "fromBeforePass"
        ]
      }
    },
    "foreignCommits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
          },
          "subject": {
            "type": "string"
          }
        },
        "required": [
          "sha",
          "subject"
        ]
      }
    },
    "summary": {
      "type": "string"
    },
    "gate": {
      "type": "object",
      "properties": {
        "where": {
          "type": "string",
          "enum": [
            "scratch",
            "folder",
            "none"
          ]
        },
        "consequence": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "where",
        "consequence"
      ]
    }
  },
  "required": [
    "token",
    "unfinished",
    "unowned",
    "foreignCommits",
    "summary",
    "gate"
  ]
}
