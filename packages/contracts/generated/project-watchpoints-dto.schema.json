{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "effective": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "why": {
            "type": "string",
            "maxLength": 400
          },
          "globs": {
            "minItems": 1,
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "lines": {
            "default": [],
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "question": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              {
                "type": "null"
              }
            ]
          },
          "guidance": {
            "type": "string",
            "maxLength": 2000
          },
          "loudness": {
            "type": "string",
            "enum": [
              "show",
              "ask",
              "hold"
            ]
          },
          "starter": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          },
          "from": {
            "type": "string",
            "enum": [
              "you",
              "project",
              "override"
            ]
          }
        },
        "required": [
          "key",
          "label",
          "why",
          "globs",
          "guidance",
          "loudness",
          "from"
        ]
      }
    },
    "entries": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "why": {
                "type": "string",
                "maxLength": 400
              },
              "globs": {
                "minItems": 1,
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "lines": {
                "default": [],
                "maxItems": 16,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "question": {
                "default": null,
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 400
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "guidance": {
                "type": "string",
                "maxLength": 2000
              },
              "loudness": {
                "type": "string",
                "enum": [
                  "show",
                  "ask",
                  "hold"
                ]
              },
              "starter": {
                "default": null,
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "key",
              "label",
              "why",
              "globs",
              "guidance",
              "loudness"
            ]
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "off": {
                "type": "boolean",
                "const": true
              }
            },
            "required": [
              "key",
              "off"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "effective",
    "entries"
  ]
}
