{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string",
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "projectId": {
                "type": "string",
                "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "acceptanceCriteria": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "areas": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "riskTags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "security",
                    "auth",
                    "migration",
                    "dependency"
                  ]
                }
              },
              "flowId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^flw_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "landing": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "base"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "branch"
                      },
                      "branch": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
                      }
                    },
                    "required": [
                      "kind",
                      "branch"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "hold"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  }
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "open",
                  "done",
                  "cancelled"
                ]
              },
              "boardOrder": {
                "type": "number"
              },
              "boardColumnId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^bcl_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "dependsOn": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                }
              },
              "boardStatus": {
                "type": "string",
                "enum": [
                  "backlog",
                  "ready",
                  "in_progress",
                  "blocked",
                  "done"
                ]
              },
              "workstreamId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "goalId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^gol_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              }
            },
            "required": [
              "id",
              "projectId",
              "title",
              "description",
              "acceptanceCriteria",
              "areas",
              "riskTags",
              "flowId",
              "landing",
              "status",
              "boardOrder",
              "boardColumnId",
              "dependsOn",
              "boardStatus",
              "workstreamId",
              "createdAt",
              "updatedAt"
            ]
          },
          "proposed": {
            "type": "boolean"
          },
          "resumed": {
            "type": "boolean"
          },
          "unblocks": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "area",
                    "hazard"
                  ]
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "name"
              ]
            }
          },
          "conflict": {
            "type": [
              "string",
              "null"
            ]
          },
          "plan": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "flowName": {
                    "type": "string"
                  },
                  "steps": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": [
                            "plan",
                            "plan_review",
                            "implement",
                            "review",
                            "qa"
                          ]
                        },
                        "personaId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^per_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "personaName": {
                          "type": "string"
                        },
                        "tools": {
                          "type": "string",
                          "enum": [
                            "read_only",
                            "edit"
                          ]
                        },
                        "score": {
                          "type": "string",
                          "enum": [
                            "intelligence",
                            "coding",
                            "agentic"
                          ]
                        },
                        "profileId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^mpf_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "model": {
                          "type": "string",
                          "minLength": 1
                        },
                        "effort": {
                          "type": "string",
                          "enum": [
                            "low",
                            "medium",
                            "high",
                            "xhigh",
                            "max"
                          ]
                        },
                        "need": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        },
                        "reason": {
                          "type": "string"
                        },
                        "overBudget": {
                          "type": "boolean"
                        },
                        "pinned": {
                          "type": "boolean"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "pending",
                            "running",
                            "done",
                            "failed"
                          ]
                        },
                        "attempts": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "startedAt": {
                          "anyOf": [
                            {
                              "type": "string",
                              "format": "date-time",
                              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "sessionFloor": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "result": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "summary": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 8000
                                },
                                "verdict": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "enum": [
                                        "approve",
                                        "reject"
                                      ]
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "sessionId": {
                                  "type": "string",
                                  "pattern": "^ses_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                                },
                                "at": {
                                  "type": "string",
                                  "format": "date-time",
                                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                                }
                              },
                              "required": [
                                "summary",
                                "verdict",
                                "sessionId",
                                "at"
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "role",
                        "personaId",
                        "personaName",
                        "tools",
                        "score",
                        "profileId",
                        "model",
                        "effort",
                        "need",
                        "reason",
                        "overBudget",
                        "pinned",
                        "status",
                        "attempts",
                        "startedAt",
                        "sessionFloor",
                        "result"
                      ]
                    }
                  },
                  "overBudget": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  }
                },
                "required": [
                  "flowName",
                  "steps",
                  "overBudget"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "planError": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "task",
          "proposed",
          "resumed",
          "unblocks",
          "claims",
          "conflict",
          "plan",
          "planError"
        ]
      }
    }
  },
  "required": [
    "projectId",
    "size",
    "candidates"
  ]
}
