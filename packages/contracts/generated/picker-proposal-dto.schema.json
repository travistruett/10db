                      "required": [
                        "role",
                        "personaId",
                        "personaName",
                        "tools",
                        "profileId",
                        "model",
                        "effort",
                        "need",
                        "reason",
                        "overBudget",
                        "pinned",
                        "status",
                        "attempts",
                        "startedAt",
                        "sessionFloor",
                        "result"
