{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string",
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "projectId": {
                "type": "string",
                "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "title": {
                "type": "string"
              },
              "headline": {
                "type": "string"
              },
              "why": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "acceptanceCriteria": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "areas": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rigor": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "light",
                      "standard",
                      "careful",
                      "critical"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "effectiveRigor": {
                "type": "string",
                "enum": [
                  "light",
                  "standard",
                  "careful",
                  "critical"
                ]
              },
              "kinds": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,39}$"
                    },
                    "source": {
                      "type": "string",
                      "enum": [
                        "builder",
                        "agent"
                      ]
                    }
                  },
                  "required": [
                    "key",
                    "source"
                  ]
                }
              },
              "effortPin": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high",
                      "xhigh",
                      "max"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "landing": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "base"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "branch"
                      },
                      "branch": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
                      }
                    },
                    "required": [
                      "kind",
                      "branch"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "hold"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  }
                ]
              },
              "workspaceMode": {
                "type": "string",
                "enum": [
                  "shared",
                  "worktree"
                ]
              },
              "placementReason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "open",
                  "done",
                  "cancelled"
                ]
              },
              "boardOrder": {
                "type": "number"
              },
              "boardColumnId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^bcl_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "dependsOn": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                }
              },
              "boardStatus": {
                "type": "string",
                "enum": [
                  "backlog",
                  "ready",
                  "in_progress",
                  "in_review",
                  "blocked",
                  "done"
                ]
              },
              "workstreamId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "goalId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^gol_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "landingGroupId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^lgp_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "passId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^pas_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "keptWork": {
                "type": "boolean"
              },
              "modelSetting": {
                "anyOf": [
                  {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "automatic"
                          },
                          "minimum": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100
                          }
                        },
                        "required": [
                          "kind"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "tier"
                          },
                          "tier": {
                            "type": "string",
                            "enum": [
                              "efficient",
                              "balanced",
                              "capable",
                              "frontier"
                            ]
                          }
                        },
                        "required": [
                          "kind",
                          "tier"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "top_of_tier"
                          },
                          "tier": {
                            "type": "string",
                            "enum": [
                              "efficient",
                              "balanced",
                              "capable",
                              "frontier"
                            ]
                          }
                        },
                        "required": [
                          "kind"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "model"
                          },
                          "model": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "kind",
                          "model"
                        ]
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "updatedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              }
            },
            "required": [
              "id",
              "projectId",
              "title",
              "headline",
              "why",
              "description",
              "acceptanceCriteria",
              "areas",
              "rigor",
              "effectiveRigor",
              "kinds",
              "effortPin",
              "landing",
              "workspaceMode",
              "placementReason",
              "status",
              "boardOrder",
              "boardColumnId",
              "dependsOn",
              "boardStatus",
              "workstreamId",
              "modelSetting",
              "createdAt",
              "updatedAt"
            ]
          },
          "proposed": {
            "type": "boolean"
          },
          "resumed": {
            "type": "boolean"
          },
          "unblocks": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "area",
                    "hazard"
                  ]
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "name"
              ]
            }
          },
          "conflict": {
            "type": [
              "string",
              "null"
            ]
          },
          "plan": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "rigor": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "light",
                          "standard",
                          "careful",
                          "critical"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "steps": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": [
                            "plan",
                            "plan_review",
                            "implement",
                            "review",
                            "qa"
                          ]
                        },
                        "personaId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^per_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "personaName": {
                          "type": "string"
                        },
                        "tools": {
                          "type": "string",
                          "enum": [
                            "read_only",
                            "edit"
                          ]
                        },
                        "profileId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^mpf_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "model": {
                          "type": "string",
                          "minLength": 1
                        },
                        "effort": {
                          "type": "string",
                          "enum": [
                            "low",
                            "medium",
                            "high",
                            "xhigh",
                            "max"
                          ]
                        },
                        "need": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        },
                        "setting": {
                          "default": null,
                          "anyOf": [
                            {
                              "oneOf": [
                                {
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "type": "string",
                                      "const": "automatic"
                                    },
                                    "minimum": {
                                      "type": "number",
                                      "minimum": 0,
                                      "maximum": 100
                                    }
                                  },
                                  "required": [
                                    "kind"
                                  ]
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "type": "string",
                                      "const": "tier"
                                    },
                                    "tier": {
                                      "type": "string",
                                      "enum": [
                                        "efficient",
                                        "balanced",
                                        "capable",
                                        "frontier"
                                      ]
                                    }
                                  },
                                  "required": [
                                    "kind",
                                    "tier"
                                  ]
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "type": "string",
                                      "const": "top_of_tier"
                                    },
                                    "tier": {
                                      "type": "string",
                                      "enum": [
                                        "efficient",
                                        "balanced",
                                        "capable",
                                        "frontier"
                                      ]
                                    }
                                  },
                                  "required": [
                                    "kind"
                                  ]
                                },
                                {
                                  "type": "object",
                                  "properties": {
                                    "kind": {
                                      "type": "string",
                                      "const": "model"
                                    },
                                    "model": {
                                      "type": "string",
                                      "minLength": 1
                                    }
                                  },
                                  "required": [
                                    "kind",
                                    "model"
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "reason": {
                          "type": "string"
                        },
                        "overBudget": {
                          "type": "boolean"
                        },
                        "pinned": {
                          "type": "boolean"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "pending",
                            "running",
                            "done",
                            "failed"
                          ]
                        },
                        "attempts": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "startedAt": {
                          "anyOf": [
                            {
                              "type": "string",
                              "format": "date-time",
                              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "sessionFloor": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "retryFloor": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "result": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "summary": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 8000
                                },
                                "verdict": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "enum": [
                                        "approve",
                                        "reject"
                                      ]
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "sessionId": {
                                  "type": "string",
                                  "pattern": "^ses_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                                },
                                "at": {
                                  "type": "string",
                                  "format": "date-time",
                                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                                }
                              },
                              "required": [
                                "summary",
                                "verdict",
                                "sessionId",
                                "at"
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "earlier": {
                          "default": [],
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "summary": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 8000
                              },
                              "verdict": {
                                "anyOf": [
                                  {
                                    "type": "string",
                                    "enum": [
                                      "approve",
                                      "reject"
                                    ]
                                  },
                                  {
                                    "type": "null"
                                  }
                                ]
                              },
                              "sessionId": {
                                "type": "string",
                                "pattern": "^ses_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                              },
                              "at": {
                                "type": "string",
                                "format": "date-time",
                                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                              }
                            },
                            "required": [
                              "summary",
                              "verdict",
                              "sessionId",
                              "at"
                            ]
                          }
                        },
                        "sentBack": {
                          "default": 0,
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "reviewRounds": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 3
                        },
                        "providerSessionId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "shippedAtLimit": {
                          "type": "object",
                          "properties": {
                            "followUpTaskId": {
                              "type": "string",
                              "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                            },
                            "followUpTitle": {
                              "type": "string",
                              "minLength": 1
