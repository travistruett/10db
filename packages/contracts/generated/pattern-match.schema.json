{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "roles": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "plan",
          "plan_review",
          "implement",
          "review",
          "qa"
        ]
      }
    },
    "riskTags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "security",
          "auth",
          "migration",
          "dependency"
        ]
      }
    },
    "areas": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "retryOnly": {
      "default": false,
      "type": "boolean"
    }
  }
}
