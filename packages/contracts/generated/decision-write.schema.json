{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scope": {
      "description": "you, project or area. Default: project.",
      "type": "string",
      "enum": [
        "you",
        "project",
        "area"
      ]
    },
    "area": {
      "description": "The area, for scope \"area\".",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "choice": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "source": {
      "type": "object",
      "properties": {
        "via": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "The tool that wrote it, such as claude_code."
        },
        "sessionId": {
          "description": "The tool's own session id.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "quote": {
          "description": "The builder's own words.",
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "via"
      ],
      "additionalProperties": false
    },
    "dryRun": {
      "description": "Write nothing; answer what would be written.",
      "type": "boolean"
    }
  },
  "required": [
    "question",
    "choice",
    "rationale"
  ],
  "additionalProperties": false
}
