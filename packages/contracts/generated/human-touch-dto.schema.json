{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "permission": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "question": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "workstreamFailed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "flag": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "proposal": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "review": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "check": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cards": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "tasksRan": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cardsPerTask": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "waitingMinutes": {
            "type": "number",
            "minimum": 0
          },
          "failedMinutes": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "day",
          "permission",
          "question",
          "workstreamFailed",
          "flag",
          "proposal",
          "review",
          "check",
          "cards",
          "tasksRan",
          "cardsPerTask",
          "waitingMinutes",
          "failedMinutes"
        ]
      }
    }
  },
  "required": [
    "days"
  ]
}
