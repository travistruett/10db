{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "The outcome, as what is true when it is done."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "What you saw, where, and why it matters."
    },
    "acceptanceCriteria": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "opId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,100}$",
      "description": "A unique ID for this call. Reuse it only when retrying the same call."
    }
  },
  "required": [
    "title",
    "description",
    "opId"
  ]
}
