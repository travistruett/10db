{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "plan",
        "plan_review",
        "implement",
        "review",
        "qa"
      ]
    },
    "projectId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "setting": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "automatic"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tier"
            },
            "tier": {
              "type": "string",
              "enum": [
                "efficient",
                "balanced",
                "capable",
                "frontier"
              ]
            }
          },
          "required": [
            "kind",
            "tier"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "top_of_tier"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "model"
            },
            "model": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "model"
          ]
        }
      ]
    }
  },
  "required": [
    "role",
    "projectId",
    "setting"
  ]
}
