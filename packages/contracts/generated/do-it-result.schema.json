{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "place": {
          "type": "string",
          "enum": [
            "worktree",
            "here"
          ]
        }
      },
      "required": [
        "taskId",
        "place"
      ]
    },
    {
      "type": "object",
      "properties": {
        "pending": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "pending"
      ]
    }
  ]
}
