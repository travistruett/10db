{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "precedents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^tpd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "projectId": {
            "type": "string",
            "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "programKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}]+$"
          },
          "scope": {
            "type": "string",
            "enum": [
              "copy",
              "project"
            ]
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}]+$"
          },
          "examples": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\\p{Cc}\\p{Cf}\\p{Zl}\\p{Zp}]+$"
            }
          },
          "runsHash": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "active",
              "paused",
              "declined",
              "revoked"
            ]
          },
          "uses": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "lastUsedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "conflicts": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "sourceInboxId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^inb_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "endedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastAllowed": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "call": {
                  "type": "string"
                },
                "at": {
                  "type": "string"
                }
              },
              "required": [
                "call",
                "at"
              ]
            }
          }
        },
        "required": [
          "id",
          "projectId",
          "programKey",
          "scope",
          "kind",
          "examples",
          "runsHash",
          "state",
          "uses",
          "lastUsedAt",
          "conflicts",
          "sourceInboxId",
          "createdAt",
          "endedAt",
          "lastAllowed"
        ]
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "programKey": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "copy",
              "project"
            ]
          },
          "kind": {
            "type": "string"
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "runs": {
            "type": [
              "string",
              "null"
            ]
          },
          "runsHash": {
            "type": [
              "string",
              "null"
            ]
          },
          "skips": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "runCount": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "taskCount": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "topWorry": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "limit": {
                    "type": "string",
                    "enum": [
                      "destroys_data",
                      "sends_data_out",
                      "reads_secrets",
                      "writes_live"
                    ]
                  },
                  "p": {
                    "type": "number"
                  }
                },
                "required": [
                  "limit",
                  "p"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "stoppedAtLimit": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "programKey",
          "scope",
          "kind",
          "examples",
          "runs",
          "runsHash",
          "skips",
          "runCount",
          "taskCount",
          "topWorry",
          "stoppedAtLimit"
        ]
      }
    }
  },
  "required": [
    "precedents",
    "candidates"
  ]
}
