{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "automatic"
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "tier"
        },
        "tier": {
          "type": "string",
          "enum": [
            "fast",
            "balanced",
            "strongest"
          ]
        }
      },
      "required": [
        "kind",
        "tier"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "top_of_tier"
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "model"
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "model"
      ]
    }
  ]
}
