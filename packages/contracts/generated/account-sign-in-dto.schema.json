{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "accountId": {
      "type": "string",
      "pattern": "^acc_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "configDir": {
      "type": [
        "string",
        "null"
      ]
    },
    "command": {
      "type": "string"
    }
  },
  "required": [
    "accountId",
    "configDir",
    "command"
  ]
}
