{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "isDefault": {
      "type": "boolean"
    },
    "runningCommit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "availableCommit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "notInstalling": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "failed",
            "rolled-back",
            "unbuilt",
            "fetching",
            "unreachable"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "waitMinutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "waitingSince": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "draining": {
      "type": "boolean"
    },
    "drainingSince": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "midSession": {
      "type": "object",
      "properties": {
        "working": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "waitingOnCard": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "batches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "jobs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "shapes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^shp_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title"
            ]
          }
        }
      },
      "required": [
        "working",
        "waitingOnCard",
        "batches",
        "jobs",
        "shapes"
      ]
    },
    "blocker": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "source",
                "no-repository",
                "not-in-applications",
                "gh-missing",
                "unreachable",
                "failed"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "message"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "enabled",
    "isDefault",
    "runningCommit",
    "availableCommit",
    "notInstalling",
    "waitMinutes",
    "waitingSince",
    "draining",
    "drainingSince",
    "midSession",
    "blocker"
  ]
}
