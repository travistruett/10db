{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "effortKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "markdown": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
