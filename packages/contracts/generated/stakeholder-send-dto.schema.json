{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^snd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "inboxItemId": {
      "type": "string",
      "pattern": "^inb_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "draft",
        "sending",
        "sent",
        "answered",
        "closed",
        "failed"
      ]
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "personId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^psn_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "userId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "recipient": {
            "type": "boolean"
          }
        },
        "required": [
          "personId",
          "userId",
          "name",
          "recipient"
        ]
      }
    },
    "text": {
      "type": "string"
    },
    "hits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "severity": {
            "type": "string",
            "enum": [
              "hold",
              "warn"
            ]
          }
        },
        "required": [
          "pattern",
          "line",
          "severity"
        ]
      }
    },
    "permalink": {
      "type": [
        "string",
        "null"
      ]
    },
    "sentAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "remindedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "answeredAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "returnedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "returnedReason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "timer",
            "disagreed"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "heldBy": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "review",
            "first_send",
            "limit",
            "scan"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "proposal": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "choice": {
              "type": "string"
            },
            "confidence": {
              "type": "number"
            }
          },
          "required": [
            "choice",
            "confidence"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "askedWhichWay": {
      "type": "boolean"
    },
    "conversation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "ts": {
            "type": "string"
          }
        },
        "required": [
          "userId",
          "name",
          "text",
          "ts"
        ]
      }
    },
    "reply": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "userId": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            }
          },
          "required": [
            "text",
            "userId",
            "ts"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "replyVia": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "thread",
            "top_level"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "readAs": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "option",
            "own_words",
            "approved"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "answeredBy": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^psn_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "inboxItemId",
    "state",
    "people",
    "text",
    "hits",
    "permalink",
    "sentAt",
    "remindedAt",
    "answeredAt",
    "returnedAt",
    "returnedReason",
    "heldBy",
    "proposal",
    "askedWhichWay",
    "conversation",
    "reply",
    "replyVia",
    "readAs",
    "answeredBy",
    "error"
  ]
}
