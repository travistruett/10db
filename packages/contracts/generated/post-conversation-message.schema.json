{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "text": {
      "type": "string"
    },
    "mentions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "folder": {
      "type": "string",
      "enum": [
        "wait",
        "read_only"
      ]
    }
  },
  "required": [
    "text"
  ]
}
