{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "maxLength": 16
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "platform": {
      "type": "string",
      "enum": [
        "android",
        "ios",
        "macos",
        "other"
      ]
    }
  },
  "required": [
    "code",
    "label",
    "platform"
  ]
}
