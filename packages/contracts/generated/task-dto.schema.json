{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string"
    },
    "headline": {
      "type": "string"
    },
    "why": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rigor": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "light",
            "standard",
            "careful",
            "critical"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "effectiveRigor": {
      "type": "string",
      "enum": [
        "light",
        "standard",
        "careful",
        "critical"
      ]
    },
    "rigorSource": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "judge",
            "agent",
            "builder"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "rigorReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "effectiveRigorSource": {
      "type": "string",
      "enum": [
        "judge",
        "agent",
        "builder",
        "rules",
        "default"
      ]
    },
    "effectiveRigorReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "kindsOff": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sizedByRules": {
      "type": "boolean"
    },
    "kinds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "source": {
            "type": "string",
            "enum": [
              "builder",
              "agent",
              "rules",
              "judge"
            ]
          }
        },
        "required": [
          "key",
          "source"
        ]
      }
    },
    "effortPin": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "landing": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "base"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "branch"
            },
            "branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
            }
          },
          "required": [
            "kind",
            "branch"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "hold"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "workspaceMode": {
      "type": "string",
      "enum": [
        "shared",
        "worktree"
      ]
    },
    "placementReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "done",
        "cancelled"
      ]
    },
    "boardOrder": {
      "type": "number"
    },
    "boardColumnId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^bcl_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "boardStatus": {
      "type": "string",
      "enum": [
        "backlog",
        "ready",
        "in_progress",
        "in_review",
        "blocked",
        "done"
      ]
    },
    "workstreamId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "goalId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^gol_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "landingGroupId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^lgp_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "passId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^pas_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "keptWork": {
      "type": "boolean"
    },
    "modelSetting": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "automatic"
                },
                "minimum": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "kind"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "tier"
                },
                "tier": {
                  "type": "string",
                  "enum": [
                    "efficient",
                    "balanced",
                    "capable",
                    "frontier"
                  ]
                }
              },
              "required": [
                "kind",
                "tier"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "top_of_tier"
                },
                "tier": {
                  "type": "string",
                  "enum": [
                    "efficient",
                    "balanced",
                    "capable",
                    "frontier"
                  ]
                }
              },
              "required": [
                "kind"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "model"
                },
                "model": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "model"
              ]
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "id",
    "projectId",
    "title",
    "headline",
    "why",
    "description",
    "acceptanceCriteria",
    "areas",
    "rigor",
    "effectiveRigor",
    "rigorSource",
    "rigorReason",
    "effectiveRigorSource",
    "effectiveRigorReason",
    "kindsOff",
    "sizedByRules",
    "kinds",
    "effortPin",
    "landing",
    "workspaceMode",
    "placementReason",
    "status",
    "boardOrder",
    "boardColumnId",
    "dependsOn",
    "boardStatus",
    "workstreamId",
    "modelSetting",
    "createdAt",
    "updatedAt"
  ]
}
