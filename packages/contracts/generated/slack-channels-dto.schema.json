{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "const": "ok"
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string"
              },
              "isPrivate": {
                "type": "boolean"
              },
              "isMember": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "name",
              "isPrivate",
              "isMember"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "state",
        "channels"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "const": "missing_scope"
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false
    }
  ]
}
