{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[\\x21\\x23-\\x5b\\x5d-\\x7e]+$"
    }
  },
  "required": [
    "token"
  ],
  "additionalProperties": false
}
