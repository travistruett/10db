{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "plan",
        "plan_review",
        "implement",
        "review",
        "qa"
      ]
    },
    "need": {
      "type": "number"
    },
    "profileId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^mpf_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "effort": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "intelligence": {
      "type": [
        "number",
        "null"
      ]
    },
    "costPerTaskUsd": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "role",
    "need",
    "profileId",
    "model",
    "effort",
    "intelligence",
    "costPerTaskUsd",
    "reason"
  ]
}
