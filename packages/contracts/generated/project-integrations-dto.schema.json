{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "github": {
      "type": "object",
      "properties": {
        "login": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "login"
      ],
      "additionalProperties": false
    },
    "slack": {
      "type": "object",
      "properties": {
        "teamId": {
          "type": [
            "string",
            "null"
          ]
        },
        "teamName": {
          "type": [
            "string",
            "null"
          ]
        },
        "auto": {
          "type": "boolean"
        }
      },
      "required": [
        "teamId",
        "teamName",
        "auto"
      ],
      "additionalProperties": false
    },
    "linear": {
      "type": "object",
      "properties": {
        "on": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "maxLength": 4000
        },
        "blockedBy": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "on",
        "note",
        "blockedBy"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "github",
    "slack",
    "linear"
  ],
  "additionalProperties": false
}
