{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "github": {
      "type": "object",
      "properties": {
        "login": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "login"
      ],
      "additionalProperties": false
    },
    "slack": {
      "type": "object",
      "properties": {
        "teamId": {
          "type": [
            "string",
            "null"
          ]
        },
        "teamName": {
          "type": [
            "string",
            "null"
          ]
        },
        "auto": {
          "type": "boolean"
        }
      },
      "required": [
        "teamId",
        "teamName",
        "auto"
      ],
      "additionalProperties": false
    },
    "linear": {
      "type": "object",
      "properties": {
        "binding": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "workspaceId": {
                  "type": "string",
                  "minLength": 1
                },
                "workspaceName": {
                  "type": "string",
                  "minLength": 1
                },
                "teamId": {
                  "type": "string",
                  "minLength": 1
                },
                "teamKey": {
                  "type": "string",
                  "minLength": 1
                },
                "teamName": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "workspaceId",
                "workspaceName",
                "teamId",
                "teamKey",
                "teamName"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "check": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "string",
                      "const": "checking"
                    },
                    "teamKey": {
                      "type": "string"
                    },
                    "chatId": {
                      "type": "string",
                      "pattern": "^cht_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                    }
                  },
                  "required": [
                    "state",
                    "teamKey",
                    "chatId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "string",
                      "const": "refused"
                    },
                    "teamKey": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "state",
                    "teamKey",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "binding",
        "check"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "github",
    "slack",
    "linear"
  ],
  "additionalProperties": false
}
