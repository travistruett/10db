{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "you"
            }
          },
          "required": [
            "scope"
          ]
        },
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "project"
            },
            "projectId": {
              "type": "string",
              "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "scope",
            "projectId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "area"
            },
            "projectId": {
              "type": "string",
              "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "area": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "required": [
            "scope",
            "projectId",
            "area"
          ]
        }
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "choice": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "fromInboxId": {
      "type": "string",
      "pattern": "^inb_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  },
  "required": [
    "target",
    "question",
    "choice",
    "rationale"
  ]
}
