  "type": "object",
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1
    },
    "account": {
      "type": "string",
      "pattern": "^acc_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  },
