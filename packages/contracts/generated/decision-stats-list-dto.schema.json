{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "since": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "review_size",
              "shape_ready",
              "shape_record",
              "shape_elsewhere",
              "question_route",
              "thread_answer",
              "reply_match",
              "approval_read"
            ]
          },
          "calls": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "acted": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "belowFloor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "shadow": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "stopped": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "fallbacks": {
            "type": "object",
            "properties": {
              "off": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "no_key": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "timeout": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "error": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "off",
              "no_key",
              "timeout",
              "error"
            ]
          },
          "costUsd": {
            "type": "number",
            "minimum": 0
          },
          "medianLatencyMs": {
            "type": [
              "number",
              "null"
            ]
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "model": {
                  "type": "string"
                },
                "confidence": {
                  "type": "number"
                }
              },
              "required": [
                "model",
                "confidence"
              ]
            }
          }
        },
        "required": [
          "decision",
          "calls",
          "acted",
          "belowFloor",
          "shadow",
          "stopped",
          "fallbacks",
          "costUsd",
          "medianLatencyMs",
          "answers"
        ]
      }
    }
  },
  "required": [
    "since",
    "decisions"
  ]
}
