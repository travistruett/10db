{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rigor": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "light",
            "standard",
            "careful",
            "critical"
          ]
        },
        {
          "type": "string",
          "const": "all"
        }
      ]
    },
    "tasksDone": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "stepsPerTask": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "sessionsPerTask": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "sendBacksPerTask": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "pullRequestsPerGoal": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "shippedWithFindings": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "rigor",
    "tasksDone",
    "stepsPerTask",
    "sessionsPerTask",
    "sendBacksPerTask",
    "pullRequestsPerGoal",
    "shippedWithFindings"
  ]
}
