              "followUpTitle": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "followUpTaskId",
              "followUpTitle"
            ]
          }
        },
        "required": [
          "role",
          "personaId",
          "personaName",
          "tools",
          "profileId",
          "model",
          "effort",
          "need",
          "reason",
          "overBudget",
          "pinned",
          "status",
          "attempts",
          "startedAt",
          "sessionFloor",
          "result"
        ]
      }
    },
    "stepIndex": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "currentSessionId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^ses_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
