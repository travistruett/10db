          "setting": {
            "default": null,
            "anyOf": [
              {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "automatic"
                      },
                      "minimum": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "tier"
                      },
                      "tier": {
                        "type": "string",
                        "enum": [
                          "efficient",
                          "balanced",
                          "capable",
                          "frontier"
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "tier"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "top_of_tier"
                      },
                      "tier": {
                        "type": "string",
                        "enum": [
                          "efficient",
                          "balanced",
                          "capable",
                          "frontier"
                        ]
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "model"
                      },
                      "model": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "model"
                    ]
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string"
          },
          "overBudget": {
            "type": "boolean"
          },
          "pinned": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "done",
              "failed"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "startedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "sessionFloor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "retryFloor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "result": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  },
                  "verdict": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "approve",
                          "reject"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sessionId": {
                    "type": "string",
                    "pattern": "^ses_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  }
                },
                "required": [
                  "summary",
                  "verdict",
                  "sessionId",
                  "at"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "earlier": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8000
                },
                "verdict": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "approve",
                        "reject"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sessionId": {
                  "type": "string",
                  "pattern": "^ses_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                }
              },
              "required": [
                "summary",
                "verdict",
                "sessionId",
                "at"
              ]
            }
          },
          "sentBack": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reviewRounds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "providerSessionId": {
            "type": "string",
            "minLength": 1
          },
          "fixFresh": {
            "type": "string",
            "enum": [
              "pending",
              "done"
            ]
          },
          "shippedAtLimit": {
            "type": "object",
            "properties": {
              "followUpTaskId": {
                "type": "string",
                "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
