          "personaName": {
            "type": "string"
          },
          "tools": {
            "type": "string",
            "enum": [
              "read_only",
              "edit"
            ]
          },
          "profileId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^mpf_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ]
          },
          "need": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
