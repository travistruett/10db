  "required": [
    "id",
    "taskId",
    "taskTitle",
    "taskHeadline",
    "projectId",
    "batchId",
    "state",
    "nextAction",
    "attempt",
    "recoveryAttempts",
    "model",
    "effort",
    "steps",
    "stepIndex",
