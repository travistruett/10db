{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "taskId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "tone": {
      "type": "string",
      "enum": [
        "info",
        "warning"
      ]
    },
    "line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "body": {
      "type": "string",
      "maxLength": 8000
    }
  },
  "required": [
    "projectId",
    "taskId",
    "key",
    "tone",
    "line",
    "body"
  ],
  "additionalProperties": false
}
