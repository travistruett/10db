{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "taskId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "tone": {
      "type": "string",
      "enum": [
        "info",
        "warning"
      ]
    },
    "line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "body": {
      "type": "string",
      "maxLength": 8000
    },
    "decision": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "enum": [
            "rule",
            "judge"
          ]
        },
        "rule": {
          "type": "string",
          "enum": [
            "stray-write",
            "flaky-check",
            "move-back-after-limit",
            "claim-deadlock"
          ]
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "undo": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "undoable"
                },
                "action": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "move_project"
                        },
                        "projectId": {
                          "type": "string",
                          "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                        },
                        "accountId": {
                          "type": "string",
                          "pattern": "^acc_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                        }
                      },
                      "required": [
                        "kind",
                        "projectId",
                        "accountId"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "forget_claim_deadlock"
                        },
                        "a": {
                          "type": "string",
                          "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                        },
                        "b": {
                          "type": "string",
                          "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                        }
                      },
                      "required": [
                        "kind",
                        "a",
                        "b"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "state",
                "action"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "final"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "state",
                "reason"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "by",
        "rule",
        "confidence",
        "undo"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "projectId",
    "taskId",
    "key",
    "tone",
    "line",
    "body"
  ],
  "additionalProperties": false
}
