                "pattern": "^ptn_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "turnSeq": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "before",
              "turn",
              "after"
            ]
          },
          "route": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^\\/(?!\\/)[^#\\\\\\s\\p{Cc}]*$"
          },
          "viewport": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 320,
                "maximum": 3840
              },
              "height": {
                "type": "integer",
                "minimum": 320,
                "maximum": 2400
              }
            },
            "required": [
              "width",
              "height"
            ]
          },
          "theme": {
            "type": "string",
            "enum": [
              "default",
              "light",
              "dark"
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "height": {
            "type": "integer",
            "minimum": 1,
