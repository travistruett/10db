{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "intent",
            "fact",
            "experiment",
            "name"
          ]
        },
        "key": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "body": {
          "$ref": "#/$defs/__schema0"
        },
        "anchors": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "code"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "commit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{7,40}$"
                  },
                  "excerpt": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "path",
                  "line",
                  "commit",
                  "excerpt"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "url"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "readAt": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  }
                },
                "required": [
                  "kind",
                  "url",
                  "readAt"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "entryKey": {
                "type": "string"
              },
              "anchorIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "result": {
                "type": "string",
                "enum": [
                  "current",
                  "moved",
                  "changed",
                  "unchecked",
                  "url"
                ]
              },
              "line": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "checkedCommit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "workstreamId": {
                "type": "string",
                "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              }
            },
            "required": [
              "entryKey",
              "anchorIndex",
              "result",
              "line",
              "checkedCommit",
              "note",
              "workstreamId",
              "at"
            ]
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verified": {
          "type": "boolean"
        },
        "checkedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "current",
            "superseded"
          ]
        }
      },
      "required": [
        "kind",
        "key",
        "title",
        "version",
        "body",
        "anchors",
        "checks",
        "sources",
        "verified",
        "checkedAt",
        "state"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "decision"
        },
        "key": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "choice": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "option": {
                "type": "string",
                "minLength": 1
              },
              "whyNot": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "option",
              "whyNot"
            ],
            "additionalProperties": false
          }
        },
        "quote": {
          "type": [
            "string",
            "null"
          ]
        },
        "lasting": {
          "type": "boolean"
        },
        "state": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "key",
        "question",
        "choice",
        "rationale",
        "alternatives",
        "quote",
        "lasting",
        "state"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "question"
        },
        "key": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "for": {
          "type": "string"
        },
        "blocks": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "key",
        "text",
        "for",
        "blocks"
      ]
    }
  ],
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
