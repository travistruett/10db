{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "accountId": {
      "type": "string",
      "pattern": "^acc_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
    },
    "total": {
      "type": "object",
      "properties": {
        "tokensIn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokensOut": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tokensCached": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "costUsd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "tokensIn",
        "tokensOut",
        "tokensCached",
        "costUsd"
      ]
    },
    "monthlyCapUsd": {
      "type": [
        "number",
        "null"
      ]
    },
    "byProject": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tokensIn": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "tokensOut": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "tokensCached": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "costUsd": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "projectId": {
            "type": "string",
            "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "projectName": {
            "type": "string"
          }
        },
        "required": [
          "tokensIn",
          "tokensOut",
          "tokensCached",
          "costUsd",
          "projectId",
          "projectName"
        ]
      }
    }
  },
  "required": [
    "accountId",
    "month",
    "total",
    "monthlyCapUsd",
    "byProject"
  ]
}
