{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "plan",
              "plan_review",
              "implement",
              "review",
              "qa"
            ]
          },
          "projectId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "setting": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "automatic"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "tier"
                  },
                  "tier": {
                    "type": "string",
                    "enum": [
                      "fast",
                      "balanced",
                      "strongest"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "tier"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "top_of_tier"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "model"
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "model"
                ]
              }
            ]
          }
        },
        "required": [
          "role",
          "projectId",
          "setting"
        ]
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^pat_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "projectId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "match": {
            "type": "object",
            "properties": {
              "roles": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "plan",
                    "plan_review",
                    "implement",
                    "review",
                    "qa"
                  ]
                }
              },
              "riskTags": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "security",
                    "auth",
                    "migration",
                    "dependency"
                  ]
                }
              },
              "areas": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "retryOnly": {
                "default": false,
                "type": "boolean"
              }
            }
          },
          "setting": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "automatic"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "tier"
                  },
                  "tier": {
                    "type": "string",
                    "enum": [
                      "fast",
                      "balanced",
                      "strongest"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "tier"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "top_of_tier"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "model"
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "model"
                ]
              }
            ]
          },
          "position": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "projectId",
          "name",
          "match",
          "setting",
          "position"
        ]
      }
    }
  },
  "required": [
    "roles",
    "patterns"
  ]
}
