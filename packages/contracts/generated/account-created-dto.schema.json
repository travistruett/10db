{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "account": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^acc_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "claude_subscription",
            "anthropic_api_key",
            "bedrock",
            "gateway"
          ]
        },
        "label": {
          "type": "string"
        },
        "payer": {
          "type": "string"
        },
        "expectedIdentity": {
          "type": [
            "string",
            "null"
          ]
        },
        "configDir": {
          "type": [
            "string",
            "null"
          ]
        },
        "settings": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "modelMap": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-z]+$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "aliases": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z]+$"
                  }
                },
                "region": {
                  "type": "string",
                  "pattern": "^[a-z]{2}(-[a-z]+)+-\\d+$"
                },
                "awsProfile": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9._-]{1,64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "region",
                "awsProfile"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "modelMap": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-z]+$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "aliases": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z]+$"
                  }
                },
                "baseUrl": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "baseUrl"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "modelMap": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[a-z]+$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "aliases": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z]+$"
                  }
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "laneCap": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "monthlyCapUsd": {
          "type": [
            "number",
            "null"
          ]
        },
        "archived": {
          "type": "boolean"
        },
        "isDefault": {
          "type": "boolean"
        },
        "secretSet": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "payer",
        "expectedIdentity",
        "configDir",
        "settings",
        "laneCap",
        "monthlyCapUsd",
        "archived",
        "isDefault",
        "secretSet",
        "createdAt",
        "updatedAt"
      ]
    },
    "signIn": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "accountId": {
              "type": "string",
              "pattern": "^acc_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "configDir": {
              "type": [
                "string",
                "null"
              ]
            },
            "command": {
              "type": "string"
            }
          },
          "required": [
            "accountId",
            "configDir",
            "command"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "account",
    "signIn"
  ]
}
