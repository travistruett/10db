{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "try",
        "cheapest"
      ]
    },
    "models": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "capUsd": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 500
    },
    "previewHash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "kind",
    "models",
    "capUsd",
    "previewHash"
  ],
  "additionalProperties": false
}
