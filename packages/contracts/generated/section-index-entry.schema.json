{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\s#]+$"
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "title": {
      "type": "string"
    },
    "start": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "end": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "slug",
    "level",
    "title",
    "start",
    "end"
  ]
}
