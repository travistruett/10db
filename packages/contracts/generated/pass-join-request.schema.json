{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pages": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "taskIds": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "firstMessage": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "pages",
    "taskIds",
    "firstMessage"
  ]
}
