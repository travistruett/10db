{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "limit": {
      "default": 20,
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "offset": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "decision": {
      "type": "string",
      "enum": [
        "review_size",
        "shape_ready",
        "shape_record",
        "shape_elsewhere",
        "question_route",
        "thread_answer",
        "reply_match",
        "approval_read"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "acted",
        "below_floor",
        "fallback_off",
        "fallback_no_key",
        "fallback_timeout",
        "fallback_error",
        "stopped",
        "shadow"
      ]
    }
  }
}
