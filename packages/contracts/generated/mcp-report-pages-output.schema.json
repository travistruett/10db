{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "accepted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "refused": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "route": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "route",
          "reason"
        ]
      }
    }
  },
  "required": [
    "accepted",
    "refused"
  ]
}
