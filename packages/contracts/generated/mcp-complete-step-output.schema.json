{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "instruction": {
      "type": "string"
    },
    "followUps": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "taskId",
          "title"
        ]
      }
    }
  },
  "required": [
    "instruction"
  ]
}
