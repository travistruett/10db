{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "opId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,100}$",
      "description": "A unique ID for this call. Reuse it only when retrying the same call."
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "choice": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "enum": [
        "project",
        "area"
      ]
    },
    "area": {
      "type": "string"
    }
  },
  "required": [
    "opId",
    "question",
    "choice",
    "rationale",
    "scope"
  ]
}
