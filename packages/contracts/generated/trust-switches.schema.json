{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "web": {
      "type": "boolean"
    },
    "projectInstructions": {
      "type": "boolean"
    },
    "yourInstructions": {
      "type": "boolean"
    },
    "yourSkills": {
      "type": "boolean"
    },
    "yourPlugins": {
      "type": "boolean"
    },
    "projectSkills": {
      "type": "boolean"
    },
    "plugins": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "yourMcpServers": {
      "default": true,
      "type": "boolean"
    },
    "mcpServers": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?:claude_json|codex_config|plugin:[A-Za-z0-9%._~!*'()-]+):[A-Za-z0-9%._~!*'()-]+$"
      },
      "additionalProperties": {
        "type": "boolean"
      }
    }
  },
  "required": [
    "web",
    "projectInstructions",
    "yourInstructions",
    "yourSkills",
    "yourPlugins",
    "projectSkills",
    "plugins"
  ],
  "additionalProperties": false
}
