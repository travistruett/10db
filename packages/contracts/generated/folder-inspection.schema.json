{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "root": {
      "type": "string"
    },
    "suggestedName": {
      "type": "string"
    },
    "branches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "remote": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "remote"
        ]
      }
    },
    "defaultBranch": {
      "type": [
        "string",
        "null"
      ]
    },
    "github": {
      "type": [
        "string",
        "null"
      ]
    },
    "gateCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "makefile",
              "package_json",
              "cargo",
              "go"
            ]
          }
        },
        "required": [
          "command",
          "source"
        ]
      }
    }
  },
  "required": [
    "root",
    "suggestedName",
    "branches",
    "defaultBranch",
    "github",
    "gateCandidates"
  ]
}
