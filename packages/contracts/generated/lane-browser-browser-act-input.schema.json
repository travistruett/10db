{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{1,32}$"
    },
    "action": {
      "type": "string",
      "enum": [
        "click",
        "fill",
        "select",
        "check",
        "press"
      ]
    },
    "value": {
      "type": "string",
      "maxLength": 10000
    },
    "dialog": {
      "type": "string",
      "const": "accept"
    }
  },
  "required": [
    "ref",
    "action"
  ],
  "additionalProperties": false
}
