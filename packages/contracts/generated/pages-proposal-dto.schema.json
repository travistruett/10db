{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "globs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "catchAll": {
            "type": "boolean"
          },
          "role": {
            "type": "string",
            "enum": [
              "page",
              "shared"
            ]
          },
          "route": {
            "type": "string",
            "maxLength": 500,
            "format": "starts_with",
            "pattern": "^\\/.*"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "name",
          "globs",
          "reason"
        ]
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "reason"
        ]
      }
    }
  },
  "required": [
    "pages",
    "skipped"
  ]
}
