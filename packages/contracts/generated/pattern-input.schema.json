{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "match": {
      "default": {},
      "type": "object",
      "properties": {
        "roles": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "plan",
              "plan_review",
              "implement",
              "review",
              "qa"
            ]
          }
        },
        "riskTags": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "security",
              "auth",
              "migration",
              "dependency"
            ]
          }
        },
        "areas": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "retryOnly": {
          "default": false,
          "type": "boolean"
        }
      }
    },
    "setting": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "automatic"
            },
            "minimum": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tier"
            },
            "tier": {
              "type": "string",
              "enum": [
                "efficient",
                "balanced",
                "capable",
                "frontier"
              ]
            }
          },
          "required": [
            "kind",
            "tier"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "top_of_tier"
            },
            "tier": {
              "type": "string",
              "enum": [
                "efficient",
                "balanced",
                "capable",
                "frontier"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "model"
            },
            "model": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "model"
          ]
        }
      ]
    }
  },
  "required": [
    "name",
    "setting"
  ]
}
