{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "opId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,100}$",
      "description": "A unique ID for this call. Reuse it only when retrying the same call."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000,
      "description": "Your plan, or your findings as numbered notes."
    },
    "verdict": {
      "default": null,
      "description": "Required for plan_review, review and QA steps; null for a plan step.",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "approve",
            "reject"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "opId",
    "summary"
  ]
}
