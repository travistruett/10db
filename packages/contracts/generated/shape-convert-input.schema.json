{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "proposalIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^spp_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "cut": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "proposalId": {
            "type": "string",
            "pattern": "^spp_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "mark": {
            "type": "string",
            "enum": [
              "needed",
              "later",
              "cut"
            ]
          }
        },
        "required": [
          "proposalId",
          "mark"
        ]
      }
    },
    "start": {
      "type": "boolean"
    }
  },
  "required": [
    "proposalIds"
  ]
}
