{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "title": {
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "boardOrder": {
          "type": "number"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "goalId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^gol_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "landingGroupId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^lgp_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "passId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^pas_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "external": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "linear"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "issueId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "url": {
                  "type": "string",
                  "maxLength": 2048,
                  "format": "uri"
                }
              },
              "required": [
                "kind",
                "id",
                "issueId",
                "url"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "workstreamId": {
          "type": "string",
          "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "settled": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "id",
        "title",
        "boardOrder",
        "updatedAt",
        "settled"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "title": {
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "boardOrder": {
          "type": "number"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "goalId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^gol_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "landingGroupId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^lgp_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "passId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^pas_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "external": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "linear"
                  ]
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "issueId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "url": {
                  "type": "string",
                  "maxLength": 2048,
                  "format": "uri"
                }
              },
              "required": [
                "kind",
                "id",
                "issueId",
                "url"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "workstreamId": {
          "type": "string",
          "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "settled": {
          "type": "boolean",
          "const": false
        },
        "criteriaCount": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "done",
            "cancelled"
          ]
        },
        "boardStatus": {
          "type": "string",
          "enum": [
            "backlog",
            "ready",
            "in_progress",
            "in_review",
            "blocked",
            "done"
          ]
        },
        "areas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rigor": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "light",
                "standard",
                "careful",
                "critical"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "effectiveRigor": {
          "type": "string",
          "enum": [
            "light",
            "standard",
            "careful",
            "critical"
          ]
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,39}$"
              },
              "source": {
                "type": "string",
                "enum": [
                  "builder",
                  "agent",
                  "rules",
                  "judge"
                ]
              }
            },
            "required": [
              "key",
              "source"
            ]
          }
        },
        "landing": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "base"
                }
              },
              "required": [
                "kind"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "branch"
                },
                "branch": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
                }
              },
              "required": [
                "kind",
                "branch"
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "hold"
                }
              },
              "required": [
                "kind"
              ]
            }
          ]
        },
        "workspaceMode": {
          "type": "string",
          "enum": [
            "shared",
            "worktree"
          ]
        },
        "placementReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "boardColumnId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^bcl_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "keptWork": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "title",
        "why",
        "boardOrder",
        "updatedAt",
        "criteriaCount",
        "status",
        "boardStatus",
        "areas",
        "rigor",
        "effectiveRigor",
        "kinds",
        "landing",
        "workspaceMode",
        "placementReason",
        "boardColumnId"
      ]
    }
  ]
}
