                  "start",
                  "continue_from_handoff",
                  "resume",
                  "answer",
                  "fix",
                  "feedback",
                  "uncommitted",
                  "merge",
                  "verify",
                  "revise",
                  "builder_review",
                  "pass_review"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "spokenTo": {
            "type": "boolean"
          },
          "turn": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^ptn_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "seq": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
