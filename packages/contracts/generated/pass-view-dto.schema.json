          "askedAt"
        ]
      }
    },
    "pullRequest": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "draft": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "state": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "open",
                    "merged",
                    "closed",
                    "unknown"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "failingChecks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "url": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "name",
                  "url"
                ]
              }
            }
          },
          "required": [
            "url",
            "draft",
            "state",
            "failingChecks"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "checks": {
      "type": "object",
      "properties": {
        "gate": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "not_run",
                "running",
                "passed",
                "failed"
              ]
            },
            "logPath": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "state",
            "logPath"
          ]
        },
        "review": {
          "type": "object",
          "properties": {
            "reviewedSha": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "reviewedSha"
          ]
        }
      },
      "required": [
        "gate",
        "review"
      ]
    },
    "closeStep": {
      "anyOf": [
        {
          "type": "number",
          "enum": [
            1,
            2,
            3,
            4,
            5,
            6,
            7,
            8
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "stackedOn": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^pas_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "checks",
              "finding",
              "stack_unmerged",
              "stack_merged",
              "pr_closed",
              "gate_failed",
              "pr_not_opened",
              "review_failed",
              "close"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "sendable": {
            "type": "boolean"
          },
          "cardId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^inb_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "kind",
          "text",
          "sendable",
          "cardId",
          "at"
        ]
      }
    }
  },
  "required": [
    "pass",
    "pages",
    "turns",
    "holds",
    "sharedChanges",
    "signOffWaits",
    "pullRequest",
    "checks",
    "closeStep",
    "stackedOn",
    "notices"
  ]
}
