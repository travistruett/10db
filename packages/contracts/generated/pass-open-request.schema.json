{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "taskIds": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "pages": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "goalId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^gol_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "pageCap": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "firstMessage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    }
  },
  "required": [
    "name",
    "taskIds"
  ]
}
