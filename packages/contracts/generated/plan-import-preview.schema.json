{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dryRun": {
      "type": "boolean",
      "const": true
    },
    "shapeId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^shp_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string"
    },
    "changes": {
      "type": "object",
      "properties": {
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "added": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              }
            },
            "required": [
              "key",
              "added"
            ]
          }
        },
        "entries": {
          "type": "object",
          "properties": {
            "added": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "changed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "superseded": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "added",
            "changed",
            "superseded"
          ]
        },
        "findings": {
          "type": "object",
          "properties": {
            "added": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "changed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "added",
            "changed"
          ]
        },
        "proposals": {
          "type": "object",
          "properties": {
            "added": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "replaced": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "keptPinned": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "changeTasks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "additions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "leftAlone": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "why": {
                    "type": "string"
                  }
                },
                "required": [
                  "key",
                  "why"
                ]
              }
            }
          },
          "required": [
            "added",
            "replaced",
            "keptPinned",
            "changeTasks",
            "additions",
            "leftAlone"
          ]
        }
      },
      "required": [
        "documents",
        "entries",
        "findings",
        "proposals"
      ]
    }
  },
  "required": [
    "dryRun",
    "shapeId",
    "title",
    "changes"
  ]
}
