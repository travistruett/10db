{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "decision"
          },
          "id": {
            "type": "string",
            "pattern": "^dec_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "question": {
            "type": "string"
          },
          "choice": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id",
          "question",
          "choice",
          "rationale"
        ]
      }
    },
    "empty": {
      "type": "boolean"
    }
  },
  "required": [
    "results",
    "empty"
  ]
}
