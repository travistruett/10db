{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "type": {
      "type": "string",
      "enum": [
        "project.created",
        "task.created",
        "task.changed",
        "workstream.created",
        "workstream.changed",
        "session.started",
        "session.activity",
        "session.context",
        "session.ended",
        "claim.acquired",
        "claim.released",
        "inbox.opened",
        "inbox.changed",
        "handoff.recorded",
        "evidence.recorded",
        "commit.recorded",
        "decision.recorded",
        "deviation.recorded",
        "proposal.created",
        "proposal.resolved",
        "provider.paused",
        "provider.resumed",
        "recovery.step",
        "settings.changed",
        "persona.saved",
        "flow.saved",
        "person.saved",
        "team.saved",
        "routing_rules.saved",
        "model_profile.saved",
        "benchmarks.synced",
        "project.changed",
        "step.changed"
      ]
    },
    "entityType": {
      "type": "string"
    },
    "entityId": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "seq",
    "type",
    "entityType",
    "entityId",
    "data",
    "at"
  ],
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
