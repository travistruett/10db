{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "switches": {
      "type": "object",
      "properties": {
        "web": {
          "type": "boolean"
        },
        "projectInstructions": {
          "type": "boolean"
        },
        "yourInstructions": {
          "type": "boolean"
        },
        "yourSkills": {
          "type": "boolean"
        },
        "yourPlugins": {
          "type": "boolean"
        },
        "projectSkills": {
          "type": "boolean"
        },
        "plugins": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "yourMcpServers": {
          "default": true,
          "type": "boolean"
        },
        "mcpServers": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(?:claude_json|codex_config|plugin:[A-Za-z0-9%._~!*'()-]+):[A-Za-z0-9%._~!*'()-]+$"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        }
      },
      "required": [
        "web",
        "projectInstructions",
        "yourInstructions",
        "yourSkills",
        "yourPlugins",
        "projectSkills",
        "plugins"
      ],
      "additionalProperties": false
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "enabledInClaude": {
            "type": "boolean"
          },
          "on": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "version",
          "enabledInClaude",
          "on"
        ]
      }
    },
    "judges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "pattern": "^acc_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "label": {
            "type": "string"
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "judge": {
            "type": "string",
            "enum": [
              "native",
              "tendb",
              "rules"
            ]
          },
          "why": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "accountId",
          "label",
          "model",
          "judge",
          "why"
        ],
        "additionalProperties": false
      }
    },
    "tendbReady": {
      "type": "boolean"
    },
    "mcpServers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^(?:claude_json|codex_config|plugin:[A-Za-z0-9%._~!*'()-]+):[A-Za-z0-9%._~!*'()-]+$"
          },
          "name": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "claude_json",
              "codex_config",
              "plugin"
            ]
          },
          "pluginId": {
            "type": [
              "string",
              "null"
            ]
          },
          "transport": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "stdio",
                  "http",
                  "sse"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "command": {
            "type": [
              "string",
              "null"
            ]
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "envNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "headerNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "shownEnv": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "value"
              ]
            }
          },
          "configHash": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "new",
              "changed",
              "approved",
              "left_out"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "on": {
            "type": "boolean"
          },
          "codexOnly": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sendsNoHeaders": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "name",
          "source",
          "pluginId",
          "transport",
          "command",
          "args",
          "cwd",
          "url",
          "envNames",
          "headerNames",
          "shownEnv",
          "configHash",
          "state",
          "reason",
          "on",
          "codexOnly",
          "sendsNoHeaders"
        ],
        "additionalProperties": false
      }
    },
    "mcpNotice": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "switches",
    "plugins",
    "judges",
    "tendbReady",
    "mcpServers",
    "mcpNotice"
  ]
}
