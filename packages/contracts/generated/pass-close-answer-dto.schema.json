{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "const": "closing"
        },
        "pass": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^pas_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "projectId": {
              "type": "string",
              "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "name": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "OPEN",
                "CLOSING",
                "CLOSED",
                "SETTLED",
                "ABANDONING",
                "ABANDONED"
              ]
            },
            "batchId": {
              "type": "string",
              "pattern": "^bat_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "pageCap": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "returnBranch": {
              "type": "string"
            },
            "startSha": {
              "type": "string"
            },
            "openedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            }
          },
          "required": [
            "id",
            "projectId",
            "name",
            "state",
            "batchId",
            "pageCap",
            "returnBranch",
            "startSha",
            "openedAt",
            "createdAt",
            "updatedAt"
          ]
        }
      },
      "required": [
        "outcome",
        "pass"
      ]
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "const": "changed"
        },
        "preview": {
          "type": "object",
          "properties": {
            "token": {
              "type": "string",
              "minLength": 1
            },
            "unfinished": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "taskId": {
                    "type": "string",
                    "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "title": {
                    "type": "string"
                  },
                  "working": {
                    "type": "boolean"
                  },
                  "sharedUnlanded": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "seq": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "paths": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "dropRefusal": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "laterPages": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "seq",
                        "paths",
                        "dropRefusal",
                        "laterPages"
                      ]
                    }
                  }
                },
                "required": [
                  "taskId",
                  "title",
                  "working",
                  "sharedUnlanded"
                ]
              }
            },
            "unowned": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "added": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "removed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "fromBeforePass": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "path",
                  "added",
                  "removed",
                  "fromBeforePass"
                ]
              }
            },
            "foreignCommits": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "sha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
                  },
                  "subject": {
                    "type": "string"
                  }
                },
                "required": [
                  "sha",
                  "subject"
                ]
              }
            },
            "summary": {
              "type": "string"
            },
            "gate": {
              "type": "object",
              "properties": {
                "where": {
                  "type": "string",
                  "enum": [
                    "scratch",
                    "folder",
                    "none"
                  ]
                },
                "consequence": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "where",
                "consequence"
              ]
            }
          },
          "required": [
            "token",
            "unfinished",
            "unowned",
            "foreignCommits",
            "summary",
            "gate"
          ]
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "outcome",
        "preview",
        "changed"
      ]
    }
  ]
}
