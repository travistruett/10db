{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "channelId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "channelName": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "enabled",
    "channelId",
    "channelName"
  ],
  "additionalProperties": false
}
