{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "model": {
          "type": "string"
        },
        "latencyMs": {
          "type": "number"
        },
        "costUsd": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "ok",
        "model",
        "latencyMs",
        "costUsd"
      ]
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": false
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "ok",
        "error"
      ]
    }
  ]
}
