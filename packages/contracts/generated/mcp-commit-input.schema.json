{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "opId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,100}$",
      "description": "A unique ID for this call. Reuse it only when retrying the same call."
    },
    "paths": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "focusNotes": {
      "description": "One entry per file you changed that your brief says a focus covers: { path, note } with your reason for the change, at most 400 characters. The builder reads it beside the changed lines.",
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "required": [
          "path",
          "note"
        ]
      }
    }
  },
  "required": [
    "opId",
    "paths",
    "message"
  ]
}
