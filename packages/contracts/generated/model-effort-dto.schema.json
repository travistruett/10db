{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profileId": {
      "type": "string",
      "pattern": "^mpf_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "effort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "intelligence": {
      "type": [
        "number",
        "null"
      ]
    },
    "costPerTaskUsd": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "outputTokensPerSecond": {
      "type": [
        "number",
        "null"
      ]
    },
    "stepsRun": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "firstPassSteps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "profileId",
    "effort",
    "intelligence",
    "costPerTaskUsd",
    "outputTokensPerSecond",
    "stepsRun",
    "firstPassSteps"
  ]
}
