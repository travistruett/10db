{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profileId": {
      "type": "string",
      "pattern": "^mpf_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "effort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "intelligence": {
      "type": [
        "number",
        "null"
      ]
    },
    "costPerTaskUsd": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "outputTokensPerSecond": {
      "type": [
        "number",
        "null"
      ]
    },
    "coding": {
      "default": null,
      "type": [
        "number",
        "null"
      ]
    },
    "agentic": {
      "default": null,
      "type": [
        "number",
        "null"
      ]
    },
    "sources": {
      "default": {
        "intelligence": null,
        "coding": null,
        "agentic": null,
        "costPerTask": null,
        "speed": null
      },
      "type": "object",
      "properties": {
        "intelligence": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "aa",
                "aa_via_openrouter",
                "openrouter"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "coding": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "aa",
                "aa_via_openrouter",
                "openrouter"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "agentic": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "aa",
                "aa_via_openrouter",
                "openrouter"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "costPerTask": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "aa",
                "aa_via_openrouter",
                "openrouter"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "speed": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "aa",
                "aa_via_openrouter",
                "openrouter"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "intelligence",
        "coding",
        "agentic",
        "costPerTask",
        "speed"
      ]
    },
    "speedProvider": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "stepsRun": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "firstPassSteps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "profileId",
    "effort",
    "intelligence",
    "costPerTaskUsd",
    "outputTokensPerSecond",
    "stepsRun",
    "firstPassSteps"
  ]
}
