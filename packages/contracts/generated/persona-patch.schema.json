{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "instructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "skills": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,39}$"
      }
    },
    "archived": {
      "type": "boolean"
    }
  }
}
