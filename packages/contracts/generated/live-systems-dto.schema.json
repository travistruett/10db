{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "liveSystems": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[^\\p{Cc}\\u2028\\u2029]+$"
      }
    }
  },
  "required": [
    "liveSystems"
  ],
  "additionalProperties": false
}
