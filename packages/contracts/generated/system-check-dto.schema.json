{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "loginEnv": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "login_shell",
            "inherited"
          ]
        },
        "warning": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "source",
        "warning"
      ]
    },
    "claudeCode": {
      "type": "object",
      "properties": {
        "verifiedOn": {
          "type": "string"
        },
        "warning": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "verifiedOn",
        "warning"
      ]
    },
    "codex": {
      "type": "object",
      "properties": {
        "verifiedOn": {
          "type": "string"
        },
        "warning": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "verifiedOn",
        "warning"
      ]
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "claude",
              "codex",
              "git",
              "docker",
              "gh"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "signedIn": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name",
          "path",
          "version",
          "required"
        ]
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string",
            "enum": [
              "claude",
              "codex"
            ]
          },
          "label": {
            "type": "string"
          },
          "pinned": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "fetching",
              "ready",
              "refused"
            ]
          },
          "problem": {
            "type": [
              "string",
              "null"
            ]
          },
          "newerRelease": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "tool",
          "label",
          "pinned",
          "state",
          "problem",
          "newerRelease"
        ]
      }
    },
    "benchmarkSync": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "unauthorized",
                "rate_limited",
                "failed"
              ]
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "outcome",
            "message"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "loginEnv",
    "claudeCode",
    "codex",
    "tools"
  ]
}
