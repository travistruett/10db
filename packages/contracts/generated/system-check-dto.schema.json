{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "loginEnv": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "login_shell",
            "inherited"
          ]
        },
        "warning": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "source",
        "warning"
      ]
    },
    "claudeCode": {
      "type": "object",
      "properties": {
        "verifiedOn": {
          "type": "string"
        },
        "warning": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "verifiedOn",
        "warning"
      ]
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "claude",
              "git",
              "docker",
              "gh"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "path",
          "version",
          "required"
        ]
      }
    }
  },
  "required": [
    "loginEnv",
    "claudeCode",
    "tools"
  ]
}
