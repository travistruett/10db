{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "page": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "status": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "url",
            "title",
            "status"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "current": {
            "type": "boolean"
          }
        },
        "required": [
          "url",
          "title",
          "current"
        ]
      }
    },
    "snapshot": {
      "type": [
        "string",
        "null"
      ]
    },
    "snapshotCut": {
      "type": "boolean"
    },
    "refused": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dialogs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "alert",
              "beforeunload",
              "confirm",
              "prompt"
            ]
          },
          "message": {
            "type": "string"
          },
          "answer": {
            "type": "string",
            "enum": [
              "accepted",
              "dismissed"
            ]
          }
        },
        "required": [
          "type",
          "message",
          "answer"
        ]
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "page",
    "pages",
    "snapshot",
    "snapshotCut",
    "refused",
    "dialogs",
    "notes"
  ]
}
