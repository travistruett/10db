{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "passId": {
      "type": "string",
      "pattern": "^pas_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "route": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^\\/(?!\\/)[^#\\\\\\s\\p{Cc}]*$"
    }
  },
  "required": [
    "passId",
    "taskId",
    "route"
  ]
}
