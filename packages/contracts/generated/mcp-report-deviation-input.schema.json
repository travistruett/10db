{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "opId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,100}$",
      "description": "A unique ID for this call. Reuse it only when retrying the same call."
    },
    "cause": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warn",
        "error"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "opId",
    "cause",
    "severity",
    "reason"
  ]
}
