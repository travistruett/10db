{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "gateCommand": {
      "type": "string",
      "minLength": 1
    },
    "maxLanes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "handoffPct": {
      "type": "integer",
      "minimum": 5,
      "maximum": 95
    },
    "nudgePct": {
      "type": "integer",
      "minimum": 6,
      "maximum": 98
    },
    "humanWaitMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 240
    },
    "flowId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^flw_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "budgetCeiling": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
