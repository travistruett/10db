{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tasks": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "suiteKey": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "not_run",
                "passing",
                "failing",
                "regressed",
                "eval_changed"
              ]
            }
          },
          "required": [
            "suiteKey",
            "label",
            "state"
          ]
        }
      }
    }
  },
  "required": [
    "tasks"
  ]
}
