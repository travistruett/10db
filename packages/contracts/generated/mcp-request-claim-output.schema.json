{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "granted": {
          "type": "boolean",
          "const": true
        },
        "claimId": {
          "type": "string",
          "pattern": "^clm_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "granted",
        "claimId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "granted": {
          "type": "boolean",
          "const": false
        },
        "heldBy": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^ws_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "inboxId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^inb_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "waiting": {
          "default": false,
          "type": "boolean"
        },
        "instruction": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "granted",
        "heldBy",
        "inboxId"
      ]
    }
  ]
}
