{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectId": {
      "type": "string",
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "acceptanceCriteria": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "areas": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependsOn": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "riskTags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "flowId": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "projectId",
    "title"
  ]
}
