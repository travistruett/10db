{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "area": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastChangedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "uncommitted": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "heldBy": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "taskId": {
                    "type": "string",
                    "pattern": "^tsk_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "title": {
                    "type": "string"
                  }
                },
                "required": [
                  "taskId",
                  "title"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "area",
          "route",
          "lastChangedAt",
          "uncommitted",
          "heldBy"
        ]
      }
    },
    "otherUncommitted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lacks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "docker_off",
              "ahead_of_base",
              "no_app_url"
            ]
          },
          "count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "kind",
          "count",
          "branch"
        ]
      }
    },
    "refusal": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "pages",
    "otherUncommitted",
    "lacks",
    "refusal"
  ]
}
