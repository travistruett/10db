{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "handle": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "slack": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "teamId": {
              "type": "string",
              "minLength": 1
            },
            "userId": {
              "type": "string",
              "minLength": 1
            },
            "sendMode": {
              "default": "review",
              "type": "string",
              "enum": [
                "review",
                "auto"
              ]
            },
            "dailyLimit": {
              "default": 10,
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "teamId",
            "userId"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "handle",
    "name"
  ]
}
