{
  "Write the greeting": [
    [
      {
        "do": "tool",
        "toolName": "AskUserQuestion",
        "input": {
          "questions": [
            {
              "question": "Which greeting?",
              "header": "Greeting",
              "options": [
                { "label": "Hello", "description": "Plain" },
                { "label": "Howdy", "description": "Friendly" }
              ],
              "multiSelect": false
            }
          ]
        }
      },
      {
        "do": "tool",
        "toolName": "Write",
        "input": { "file_path": "src/greeting/hello.txt", "content": "hello\n" }
      },
      {
        "do": "mcp",
        "tool": "commit",
        "args": {
          "opId": "op-e2e-commit1",
          "paths": ["src/greeting/hello.txt"],
          "message": "Add the greeting"
        }
      },
      { "do": "turn_complete" }
    ],
    [
      {
        "do": "mcp",
        "tool": "complete_step",
        "args": {
          "opId": "op-e2e-review1",
          "summary": "The greeting is written and committed.",
          "verdict": "approve"
        }
      },
      { "do": "turn_complete" }
    ]
  ],
  "Settings: UI work": [
    [
      { "do": "consume" },
      {
        "do": "tool",
        "toolName": "Write",
        "input": {
          "file_path": "src/views/settings/page.tsx",
          "content": "export const padding = 4;\n"
        }
      },
      { "do": "turn_complete", "text": "Tidied the settings form." },
      { "do": "await_message", "contains": "padding too tight" },
      { "do": "consume" },
      {
        "do": "tool",
        "toolName": "Edit",
        "input": {
          "file_path": "src/views/settings/page.tsx",
          "old_string": "4",
          "new_string": "12"
        }
      },
      { "do": "await_message", "contains": "the header too" },
      { "do": "consume" },
      { "do": "turn_complete", "text": "Loosened the padding." },
      { "do": "await_message", "contains": "never sent" }
    ]
  ],
  "People: UI work": [
    [
      { "do": "consume" },
      {
        "do": "tool",
        "toolName": "AskUserQuestion",
        "input": {
          "questions": [
            {
              "question": "Which spacing?",
              "header": "Spacing",
              "options": [
                { "label": "Roomy", "description": "More space" },
                { "label": "Compact", "description": "Less space" }
              ],
              "multiSelect": false
            }
          ]
        }
      },
      {
        "do": "tool",
        "toolName": "Write",
        "input": {
          "file_path": "src/views/people/page.tsx",
          "content": "export const spacing = 'roomy';\n"
        }
      },
      { "do": "turn_complete", "text": "Gave the list more room." },
      { "do": "await_message", "contains": "never sent" }
    ]
  ],
  "Pair the device": [
    [
      {
        "do": "mcp",
        "tool": "complete_step",
        "args": {
          "opId": "op-prr-plan1",
          "summary": "PLAN ONE: write notes/pair.txt.",
          "verdict": null
        }
      },
      { "do": "turn_complete" }
    ],
    [
      {
        "do": "mcp",
        "tool": "complete_step",
        "args": { "opId": "op-prr-pr1", "summary": "Looks right.", "verdict": "approve" }
      },
      { "do": "turn_complete" }
    ],
    [
      {
        "do": "tool",
        "toolName": "Write",
        "input": { "file_path": "notes/pair.txt", "content": "pair\n" }
      },
      {
        "do": "mcp",
        "tool": "commit",
        "args": {
          "opId": "op-prr-build1",
          "paths": ["notes/pair.txt"],
          "message": "Add notes/pair.txt"
        }
      },
      { "do": "turn_complete" }
    ],
    [
      {
        "do": "mcp",
        "tool": "complete_step",
        "args": { "opId": "op-prr-rev1", "summary": "Looks right.", "verdict": "approve" }
      },
      { "do": "turn_complete" }
    ],
    [
      {
        "do": "mcp",
        "tool": "complete_step",
        "args": { "opId": "op-prr-qa1", "summary": "Looks right.", "verdict": "approve" }
      },
      { "do": "turn_complete" }
    ]
  ],
  "Pair the second device": [
    [
      {
        "do": "mcp",
        "tool": "complete_step",
        "args": {
          "opId": "op-prr-plan2",
          "summary": "PLAN FIRST: write notes/second.txt.",
          "verdict": null
        }
      },
      { "do": "turn_complete" }
    ],
    [
      {
        "do": "mcp",
        "tool": "complete_step",
        "args": { "opId": "op-prr-pr2", "summary": "Looks right.", "verdict": "approve" }
      },
      { "do": "turn_complete" }
    ],
    [
      {
        "do": "mcp",
        "tool": "complete_step",
        "args": {
          "opId": "op-prr-plan3",
          "summary": "PLAN REVISED: write notes/second.txt with a header.",
          "verdict": null
        }
      },
      { "do": "turn_complete" }
    ],
    [
      {
        "do": "mcp",
        "tool": "complete_step",
        "args": { "opId": "op-prr-pr3", "summary": "Looks right.", "verdict": "approve" }
      },
      { "do": "turn_complete" }
    ],
    [
      {
        "do": "tool",
        "toolName": "Write",
        "input": { "file_path": "notes/second.txt", "content": "pair\n" }
      },
      {
        "do": "mcp",
        "tool": "commit",
        "args": {
          "opId": "op-prr-build2",
          "paths": ["notes/second.txt"],
          "message": "Add notes/second.txt"
        }
      },
      { "do": "turn_complete" }
    ],
    [
      {
        "do": "mcp",
        "tool": "complete_step",
        "args": { "opId": "op-prr-rev2", "summary": "Looks right.", "verdict": "approve" }
      },
      { "do": "turn_complete" }
    ],
    [
      {
        "do": "mcp",
        "tool": "complete_step",
        "args": { "opId": "op-prr-qa2", "summary": "Looks right.", "verdict": "approve" }
      },
      { "do": "turn_complete" }
    ]
  ]
}
