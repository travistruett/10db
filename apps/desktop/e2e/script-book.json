{
  "Write the greeting": [
    [
      {
        "do": "tool",
        "toolName": "AskUserQuestion",
        "input": {
          "questions": [
            {
              "question": "Which greeting?",
              "header": "Greeting",
              "options": [
                {
                  "label": "Hello",
                  "description": "Plain"
                },
                {
                  "label": "Howdy",
                  "description": "Friendly"
                }
              ],
              "multiSelect": false
            }
          ]
        }
      },
      {
        "do": "tool",
        "toolName": "Write",
        "input": {
          "file_path": "src/greeting/hello.txt",
          "content": "hello\n"
        }
      },
      {
        "do": "mcp",
        "tool": "commit",
        "args": {
          "opId": "op-e2e-commit1",
          "paths": ["src/greeting/hello.txt"],
          "message": "Add the greeting"
        }
      },
      {
        "do": "turn_complete"
      }
    ],
    [
      {
        "do": "mcp",
        "tool": "complete_step",
        "args": {
          "opId": "op-e2e-review1",
          "summary": "The greeting is written and committed.",
          "verdict": "approve"
        }
      },
      {
        "do": "turn_complete"
      }
    ]
  ],
  "Settings: UI work": [
    [
      {
        "do": "consume"
      },
      {
        "do": "tool",
        "toolName": "Write",
        "input": {
          "file_path": "src/views/settings/page.tsx",
          "content": "export const padding = 4;\n"
