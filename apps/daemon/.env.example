# Directory for the database, logs and backups. Default: ~/Library/Application Support/10db
TENDB_DATA_DIR=

# Loopback port the API listens on. 0 picks a free port. Default: 4317
TENDB_PORT=4317

# pino log level: fatal | error | warn | info | debug | trace. Default: info
TENDB_LOG_LEVEL=info

# Tests and development only: path to a fake-adapter script book (JSON). When set, sessions are
# scripted instead of running Claude Code. Leave empty in normal use.
TENDB_FAKE_SCRIPTS=

# Path to better_sqlite3.node. Only needed when the daemon runs from a bundle in a nonstandard
# layout; the bundle finds its own copy beside daemon.mjs, and a source run uses node_modules.
TENDB_SQLITE_BINDING=

# Set to off to keep the daemon from reading the Artificial Analysis key from the Keychain and from
# syncing benchmarks (it records no_key and makes no request). Default: on. The e2e run, live acceptance
# and `pnpm dev` set it, so only the installed app's daemon spends the shared free quota.
TENDB_BENCHMARKS=

# Set to off to keep the daemon from reading the OpenRouter key from the Keychain and from calling
# OpenRouter: every routine decision keeps today's rule. Default: on. The e2e run, live acceptance and
# `pnpm dev` set it, so only the installed app's daemon spends the builder's key.
TENDB_JUDGE=

# Test only. Set to 1 to run the live Claude adapter test on your Claude subscription (never in CI).
TENDB_LIVE_CLAUDE=

# Development and Playwright only: a fixed UI bearer token (32+ characters) instead of a random one
# per start, so a browser dev UI can use VITE_DAEMON_TOKEN. Never set it in the packaged app.
TENDB_DEV_UI_TOKEN=

# The one browser origin the API accepts beside the Tauri webview's, for a Vite dev UI. Exactly
# http://localhost:<port>, http://127.0.0.1:<port> or http://[::1]:<port> (1 to 65535, no path); the
# daemon refuses to start on anything else. Requests from it still need the UI token. Unset, no
# browser page can call the API. `pnpm dev`, live acceptance and the E2E run set it for their own
# daemons. The desktop shell passes it to the installed app's daemon, so `pnpm dev:factory` can serve
# a live UI over your real data: `pnpm dev:factory:enable` sets it in launchd's environment (until you
# log out or restart; apps opened after it, shells included, inherit it) and `pnpm dev:factory:disable`
# removes it; quit and reopen 10db after either. Not port 80, which a browser leaves out of `Origin`.
TENDB_DEV_UI_ORIGIN=

# Absolute path to the claude binary. Default: the first claude in /opt/homebrew/bin, /usr/local/bin,
# /usr/bin, ~/.local/bin or ~/.claude/local, never the login PATH.
TENDB_CLAUDE_PATH=

# Where 10db makes worktrees for worktree-mode projects; default ~/.10db/worktrees. A level named
# after the data dir is added under it. Must be an absolute path: `~` is not expanded. It may not lie
# at or under a registered checkout, the data dir or the sandbox temp root, or under a file; the daemon
# refuses to start then, and the desktop app doesn't restart it.
TENDB_WORKTREE_ROOT=

# Set to 1 by the desktop shell, which keeps the daemon's stdin open: when it closes (the shell died
# without a clean Quit) the daemon shuts down as it does on SIGTERM. Leave empty otherwise.
TENDB_PARENT_STDIN=

# How many gates (a lane's verify gate, a batch's ship gate) run at once on this machine; the rest wait
# their turn. An integer from 1 to 64. Default 1: each gate runs a whole test suite, and several at once
# overload a Mac.
TENDB_GATE_SLOTS=
