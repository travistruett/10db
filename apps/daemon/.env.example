# Directory for the database, logs and backups. Default: ~/Library/Application Support/10db
TENDB_DATA_DIR=

# Loopback port the API listens on. 0 picks a free port. Default: 4317
TENDB_PORT=4317

# pino log level: fatal | error | warn | info | debug | trace. Default: info
TENDB_LOG_LEVEL=info

# Tests and development only: path to a fake-adapter script book (JSON). When set, sessions are
# scripted instead of running Claude Code. Leave empty in normal use.
TENDB_FAKE_SCRIPTS=

# Path to better_sqlite3.node. Only needed when the daemon runs from a bundle in a nonstandard
# layout; the bundle finds its own copy beside daemon.mjs, and a source run uses node_modules.
TENDB_SQLITE_BINDING=

# Test only. Set to 1 to run the live Claude adapter test on your Claude subscription (never in CI).
TENDB_LIVE_CLAUDE=

# Development and Playwright only: a fixed UI bearer token (32+ characters) instead of a random one
# per start, so a browser dev UI can use VITE_DAEMON_TOKEN. Never set it in the packaged app.
TENDB_DEV_UI_TOKEN=

# Development and Playwright only: one more browser origin the API accepts (http on localhost or
# 127.0.0.1, on a port from 1 to 65535), for a Vite UI on a port other than 1420. The E2E run sets
# it; the desktop shell strips it from the packaged daemon.
TENDB_DEV_UI_ORIGIN=

# Absolute path to the claude binary. Default: found on the login shell's PATH at startup.
TENDB_CLAUDE_PATH=

# Dev override. Each project chooses how its lane sessions decide permission prompts in Settings >
# General (Ask for each command, or Auto mode). Set this to auto to run every project's lanes in
# auto mode regardless: Claude Code's classifier approves routine calls; the guard's refusals still
# apply first and calls the classifier escalates still become cards. Empty or default leaves each
# project to its own setting. The classifier is policy, not a boundary.
TENDB_LANE_PERMISSION_MODE=

# Set to 1 by the desktop shell, which keeps the daemon's stdin open: when it closes (the shell died
# without a clean Quit) the daemon shuts down as it does on SIGTERM. Leave empty otherwise.
TENDB_PARENT_STDIN=
