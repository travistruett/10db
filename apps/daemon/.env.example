# Directory for the database, logs and backups. Default: ~/Library/Application Support/10db
TENDB_DATA_DIR=

# Loopback port the API listens on. 0 picks a free port. Default: 4317
TENDB_PORT=4317

# pino log level: fatal | error | warn | info | debug | trace. Default: info
TENDB_LOG_LEVEL=info

# Tests and development only: path to a fake-adapter script book (JSON). When set, sessions are
# scripted instead of running Claude Code. Leave empty in normal use.
TENDB_FAKE_SCRIPTS=

# Path to better_sqlite3.node. Only needed when the daemon runs from a bundle in a nonstandard
# layout; the bundle finds its own copy beside daemon.mjs, and a source run uses node_modules.
TENDB_SQLITE_BINDING=
