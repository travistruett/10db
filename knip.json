{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [".claude/hooks/*.mjs", "scripts/**/*.mjs"]
    },
    "apps/daemon": {
      "entry": ["src/main.ts", "scripts/*.ts", "test/fake-srt.ts"],
      "ignoreDependencies": ["@anthropic-ai/sandbox-runtime"]
    },
    "apps/desktop": {
      "entry": [
        "src/main.tsx",
        "scripts/*.ts",
        "e2e/playwright.config.ts",
        "e2e/prepare.ts",
        "e2e/vitest.config.ts",
        "e2e/*.spec.ts"
      ]
    },
    "packages/contracts": {
      "entry": ["scripts/*.ts"]
    },
    "tests/repo": {
      "entry": ["src/**/*.test.ts"],
      "ignore": ["fixtures/**"]
    }
  },
  "ignore": ["spikes/**", "scratch/**"],
  "ignoreBinaries": ["codex", "mkfifo", "rustc"],
  "ignoreDependencies": ["@typescript/native"],
  "ignoreExportsUsedInFile": true
}
