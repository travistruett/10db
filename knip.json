{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [".claude/hooks/*.mjs", "scripts/**/*.mjs"]
    },
    "apps/daemon": {
      "entry": ["scripts/*.ts", "test/fake-srt.ts", "src/builder-mcp.ts"],
      "ignoreDependencies": ["@anthropic-ai/sandbox-runtime"]
    },
    "apps/desktop": {
      "entry": ["scripts/*.ts", "e2e/*.spec.ts"]
    },
    "packages/contracts": {
      "entry": ["scripts/*.ts"]
    },
    "tests/repo": {
      "entry": ["src/**/*.test.ts"],
      "ignore": ["fixtures/**"]
    }
  },
  "ignore": ["spikes/**"],
  "ignoreBinaries": ["codex", "make", "mkfifo", "rustc"],
  "ignoreExportsUsedInFile": true,
  "lefthook": {
    "config": ["lefthook.yml"]
  }
}
