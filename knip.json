{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [".claude/hooks/*.mjs", "scripts/**/*.mjs"]
    },
    "apps/daemon": {
      "entry": ["src/main.ts", "scripts/*.ts"]
    },
    "apps/desktop": {
      "entry": ["src/main.tsx", "scripts/*.ts"]
    },
    "packages/contracts": {
      "entry": ["scripts/*.ts"]
    },
    "tests/repo": {
      "entry": ["src/**/*.test.ts"],
      "ignore": ["fixtures/**"]
    }
  },
  "ignore": ["spikes/**", "scratch/**"],
  "ignoreBinaries": ["codex", "rustc"],
  "ignoreDependencies": ["@typescript/native"],
  "ignoreIssues": {
    "apps/desktop/src/daemon/queries.ts": ["exports"],
    "apps/desktop/src/test/fixtures.ts": ["exports"]
  },
  "ignoreExportsUsedInFile": true
}
