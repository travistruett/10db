root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

# The plan-record acceptance bundle keeps a CRLF line and trailing spaces byte for byte.
[apps/daemon/test/fixtures/plan-bundle/*.md]
end_of_line = unset
trim_trailing_whitespace = false
insert_final_newline = unset
