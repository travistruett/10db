# Personal Claude Code overrides (API-key fallback, local permissions). Never committed.
.claude/settings.local.json

# Claude Code runtime state, and the git worktrees it checks out for agents.
.claude/scheduled_tasks.lock
.claude/worktrees/

.DS_Store

# Local working notes and handoffs. Never committed.
scratch/

# Local environment files. Only the committed .env.example documents the variables.
.env
.env.*
!.env.example

# Spike installs and raw evidence. Results are written up in docs/architecture/research/.
spikes/agent-sdk/node_modules/
spikes/agent-sdk/out/

# Dependencies and build output.
node_modules/
dist/
coverage/
.gate/
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
*.tsbuildinfo
.eslintcache

# Personal mise overrides.
mise.local.toml

# Sidecar inputs produced by `pnpm --filter @10db/desktop sidecar`.
apps/desktop/src-tauri/binaries/
apps/desktop/src-tauri/resources/

# Local dev daemon state and the shared dev UI token (scripts/dev.sh).
/.dev/
apps/desktop/.e2e/
apps/desktop/test-results/
apps/desktop/playwright-report/
# Empty folders Claude Code can leave next to a file it writes.
**/.cc-writes/
